# OS
.DS_Store
Thumbs.db

# Foundry LevelDB (Allowing in any packs directory)
!**/packs/**/LOCK
!**/packs/**/LOG
!**/packs/**/CURRENT
!**/packs/**/MANIFEST-*
!**/packs/**/*.ldb
!**/packs/**/*.log
# Witcher Compendium Assets (Ignoring raw, allowing optimized ONLY)
witcher-compendium/images/
witcher-compendium/assets/**
!witcher-compendium/assets/optimized/**

# Zip files for releases (should not be in repo)
*.zip
