# Foundry LevelDB (Allowing in packs, ignoring elsewhere)
!witcher-compendium/packs/**/LOCK
!witcher-compendium/packs/**/LOG
!witcher-compendium/packs/**/CURRENT
!witcher-compendium/packs/**/MANIFEST-*
!witcher-compendium/packs/**/*.ldb
!witcher-compendium/packs/**/*.log
# Witcher Compendium Assets (Ignoring raw, allowing optimized)
witcher-compendium/assets/
!witcher-compendium/assets/optimized/
witcher-compendium/images/
!witcher-compendium/assets/optimized/images/
