{"_id": "23e728cb1fb44c9f", "name": "Banchetto", "type": "valuable", "img": "modules/witcher-compendium/assets/Immagini/Pag095_Oggetti Vari_01.png", "system": {"description": "<p>I banchetti sono uno spettacolo. C’è così tanto cibo che probabilmente se uno mangiasse tutto quanto morirebbe. Facile imbattersene solo alle feste di gala.</p>", "weight": 5, "cost": 100, "sourcebook": "MB 95"}, "effects": [], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {}, "_stats": {"systemId": "TheWitcherTRPG", "systemVersion": "1.0.0", "coreVersion": "13"}}
