{"_id": "0416e34f713f47bb", "name": "Trofeo: Fenice", "type": "valuable", "img": "modules/witcher-compendium/assets/Immagini_Chaos/Pag119_Oggetti Magici_01.png", "system": {"description": "<p>Il personaggio riduce la probabilità di andare A Fuoco del 50% (minimo 0%).</p>", "weight": 0, "cost": 0}, "effects": [], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {}, "_stats": {"systemId": "TheWitcherTRPG", "systemVersion": "1.0.0", "coreVersion": "13"}}
{"_id": "9df8a6c2565045cd", "name": "Trofeo: Foglet", "type": "valuable", "img": "modules/witcher-compendium/assets/Immagini_Chaos/Pag119_Oggetti Magici_01.png", "system": {"description": "<p>Il personaggio ottiene +2 alle prove di Nascondersi e Rapidità di Mano.</p>", "weight": 0, "cost": 0}, "effects": [], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {}, "_stats": {"systemId": "TheWitcherTRPG", "systemVersion": "1.0.0", "coreVersion": "13"}}
{"_id": "9f34bf6308df4db4", "name": "Trofeo: Frightener", "type": "valuable", "img": "modules/witcher-compendium/assets/Immagini_Chaos/Pag119_Oggetti Magici_01.png", "system": {"description": "<p>Il personaggio ottiene Resistenza ai danni contundenti, perforanti o taglienti. Può cambiare la tipologia ogni giorno.</p>", "weight": 0, "cost": 0}, "effects": [], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {}, "_stats": {"systemId": "TheWitcherTRPG", "systemVersion": "1.0.0", "coreVersion": "13"}}
{"_id": "504e89e9f5ba473c", "name": "Trofeo: Garkain", "type": "valuable", "img": "modules/witcher-compendium/assets/Immagini_Chaos/Pag119_Oggetti Magici_01.png", "system": {"description": "<p>Le penalità ai tiri salvezza Grinta sono ridotte di 1. In caso non vi siano penalità, il personaggio ottiene +1 a Grinta.</p>", "weight": 0, "cost": 0}, "effects": [], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {}, "_stats": {"systemId": "TheWitcherTRPG", "systemVersion": "1.0.0", "coreVersion": "13"}}
