<div class="effects-container">
    {{#each effects as |section sid|}}
        <div class="effects-group" data-effect-type="{{section.type}}">
            <div class="effects-header-row">
                <div class="header-name-group">
                    <i class="fa-solid fa-bolt-lightning header-icon"></i>
                    <h3 class="header-label">{{localize section.label}}</h3>
                </div>
                
                <div class="header-columns">
                    <span class="col-source">{{localize "WITCHER.activeEffect.source"}}</span>
                    <span class="col-duration">{{localize "EFFECT.TABS.duration"}}</span>
                </div>

                <div class="header-controls">
                    {{#unless (and (eq section.type 'temporaryItemImprovement') (not ../document.system.canHaveTemporaryItemImprovement) )}}
                        <a class="effect-control add-effect-btn btn-premium-action" data-action="create" data-tooltip="{{localize 'WITCHER.activeEffect.new'}}">
                            <i class="fas fa-plus-circle"></i> <span>{{localize "WITCHER.activeEffect.new"}}</span>
                        </a>
                    {{/unless}}
                </div>
            </div>

            <ol class="effect-list">
                {{#each section.effects as |effect|}}
                    {{#unless (and effect.isSuppressed @root.actor)}}
                        <li class="effect-item draggable {{#if effect.disabled}}is-disabled{{/if}}" 
                            data-effect-id="{{effect.id}}"
                            data-parent-id="{{effect.parent.uuid}}" 
                            data-parent-uuid="{{effect.parent.uuid}}">
                            
                            <div class="effect-main-content">
                                <a class="effect-display">
                                    <div class="effect-info">
                                        <img class="effect-img" src="{{effect.img}}" alt="{{effect.name}}"/>
                                        <span class="effect-name">{{effect.name}}</span>
                                    </div>
                                    <div class="effect-metadata">
                                        <span class="effect-source" data-tooltip="{{localize 'WITCHER.activeEffect.source'}}">{{effect.sourceName}}</span>
                                        <span class="effect-duration" data-tooltip="{{localize 'EFFECT.TABS.duration'}}">{{#if effect.duration.label}}{{effect.duration.label}}{{else}}--{{/if}}</span>
                                    </div>
                                </a>

                                <div class="effect-controls">
                                    <a class="effect-control" data-action="toggle" data-tooltip="{{localize 'WITCHER.activeEffect.toggle'}}">
                                        <i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
                                    </a>
                                    <a class="effect-control" data-action="edit" data-tooltip="{{localize 'DOCUMENT.Update' type='Effect'}}">
                                        <i class="fas fa-pen-to-square"></i>
                                    </a>
                                    <a class="effect-control delete" data-action="delete" data-tooltip="{{localize 'DOCUMENT.Delete' type='Effect'}}">
                                        <i class="fas fa-trash-can"></i>
                                    </a>
                                </div>
                            </div>

                            {{#if effect.description}}
                                <div class="effect-description invisible">
                                    {{{effect.description}}}
                                </div>
                            {{/if}}
                        </li>
                    {{/unless}}
                {{/each}}
            </ol>
        </div>
    {{/each}}
</div>