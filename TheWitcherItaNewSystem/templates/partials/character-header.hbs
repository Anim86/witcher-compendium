<div class="character-header-center">
    <!-- Character Info Bar -->
    <div class="header-details-bar">
        <div class="header-main-info">
            <h1 class="charname">
                <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'WITCHER.Name'}}" />
            </h1>
            <div class="header-tags">
                <span class="tag race" data-tooltip="{{localize 'WITCHER.Actor.Race'}}">
                    <i class="fas fa-dna"></i> {{#if race}}{{localize race.name}}{{else}}{{localize 'WITCHER.Actor.Race'}}{{/if}}
                </span>
                <span class="tag profession" data-tooltip="{{localize 'WITCHER.Actor.tabs.profession'}}">
                    <i class="fas fa-briefcase"></i> {{#if profession}}{{localize profession.name}}{{else}}{{localize 'WITCHER.Actor.tabs.profession'}}{{/if}}
                </span>
            </div>
        </div>

        <div class="header-stats-grid">
            <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.socialStanding.name'}}">
                <i class="fas fa-users"></i>
                <span>{{#if system.general.socialStanding}}{{localize (concat 'WITCHER.socialStanding.' system.general.socialStanding)}}{{else}}---{{/if}}</span>
            </div>
            <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.homeland'}}">
                <i class="fas fa-map-marked-alt"></i>
                <span>{{#if homeland}}{{localize homeland.name}}{{else}}---{{/if}}</span>
            </div>
            <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.Actor.Age'}}">
                <i class="fas fa-hourglass-half"></i>
                <span>{{system.general.age}}</span>
            </div>
            <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.Actor.Gender'}}">
                <i class="fas fa-venus-mars"></i>
                <span>{{system.general.gender}}</span>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="header-action-bar">
        <div class="bar-label">{{localize 'WITCHER.Actor.tabs.stats'}}</div>
        
        <div class="header-actions char-button-list">
            <a class="button-roll config-roll configure-actor" title="{{localize 'WITCHER.Actor.settings.actor'}}">
                <i class="fas fa-cog"></i>
            </a>
            <a class="button-roll init-roll" title="{{localize 'WITCHER.Initiative'}}">
                <i class="fas fa-running"></i>
            </a>
            <a class="button-roll verbal-roll verbal-button" title="{{localize 'WITCHER.verbalCombat'}}">
                <i class="fas fa-comments"></i>
            </a>
            <a class="button-roll crit-roll" title="{{localize 'WITCHER.Crit/Fumble'}}">
                <i class="fas fa-skull"></i>
            </a>
        </div>
    </div>
</div>