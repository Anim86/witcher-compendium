<div class="char-header-center">
    <!-- Character Info Bar -->
    <div class="header-details-bar">
        <div class="header-top-row">
            <div class="header-main-info" style="flex: 1;">
                <h1 class="charname">
                    <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'WITCHER.Name'}}" />
                </h1>
                <div class="header-tags">
                    <span class="tag race" data-tooltip="{{localize 'WITCHER.Actor.Race'}}">
                        <i class="fas fa-dna"></i> {{#if race}}{{localize race.name}}{{else}}{{localize 'WITCHER.Actor.Race'}}{{/if}}
                    </span>
                    <span class="tag profession" data-tooltip="{{localize 'WITCHER.Actor.tabs.profession'}}">
                        <i class="fas fa-briefcase"></i> {{#if profession}}{{localize profession.name}}{{else}}{{localize 'WITCHER.Actor.tabs.profession'}}{{/if}}
                    </span>
                </div>
            </div>

            <!-- Reputation Badge -->
            <div class="reputation-badge" data-action="editReputation" data-tooltip="{{localize 'WITCHER.Reputation'}}: {{localize (concat 'WITCHER.reputationLevels.' system.reputation.value)}}" data-tooltip-direction="UP">
                <div class="rep-icon">
                    <i class="fas fa-award"></i>
                </div>
                <div class="rep-details">
                    <span class="rep-label">{{localize 'WITCHER.Reputation'}}</span>
                    <span class="rep-value">{{#if system.reputation.value}}{{system.reputation.value}}{{else}}0{{/if}}</span>
                </div>
                <div class="rep-edit-hint">
                    <i class="fas fa-cog"></i>
                </div>
            </div>
        </div>

        <div class="header-stats-bottom">
            <div class="header-stats-grid">
                <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.socialStanding.name'}}">
                    <i class="fas fa-users"></i>
                    <span>{{#if system.general.socialStanding}}{{localize (concat 'WITCHER.socialStanding.' system.general.socialStanding)}}{{else}}---{{/if}}</span>
                </div>
                <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.Actor.homeland'}}">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>
                        {{#if system.general.homeland.value}}
                            {{#if (eq system.general.homeland.value "other")}}
                                {{system.general.homeland.otherValue}}
                            {{else if (lookup config.homelands system.general.homeland.value)}}
                                {{localize (lookup config.homelands system.general.homeland.value)}}
                            {{else}}
                                {{system.general.homeland.value}}
                            {{/if}}
                        {{else if homeland.name}}
                            {{localize homeland.name}}
                        {{else}}
                            ---
                        {{/if}}
                    </span>
                </div>
                <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.Actor.Age'}}">
                    <i class="fas fa-hourglass-half"></i>
                    <span>{{system.general.age}}</span>
                </div>
                <div class="header-stat-item" data-tooltip="{{localize 'WITCHER.Actor.Gender.name'}}">
                    <i class="fas fa-venus-mars"></i>
                    <span>{{#if system.gender}}{{localize (lookup config.genders system.gender)}}{{else}}---{{/if}}</span>
                </div>
                <div class="header-stat-item encumbrance-item {{#if (gt totalWeight system.derivedStats.enc.value)}}overweight{{/if}}" data-tooltip="{{localize 'WITCHER.Actor.DerStat.Enc'}}">
                    <i class="fas fa-weight-hanging"></i>
                    <span>{{totalWeight}} / {{system.derivedStats.enc.value}}</span>
                </div>
            </div>
        </div>
    </div>
</div>