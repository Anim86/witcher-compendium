<div class="char-header-center" data-application-part="header">
    <div class="header-main-info">
        <div class="name-row">
            <h1>
                <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'WITCHER.Name'}}" />
            </h1>
            <div class="header-right">
                <div class="reputation-badge" data-action="editReputation" data-tooltip="{{localize 'WITCHER.Reputation'}}">
                    <i class="fas fa-award"></i>
                    <span class="rep-label">{{localize 'WITCHER.ReputationShort'}}</span>
                    <span class="rep-value">{{#if system.reputation.value}}{{system.reputation.value}}{{else}}0{{/if}}</span>
                    <i class="fas fa-cog gear-icon"></i>
                </div>

                <div class="ip-badge standard-ip open-rewards" data-action="openRewards" data-type="standard" data-tooltip="{{localize 'WITCHER.Progression.StandardIP'}}">
                    <i class="fas fa-graduation-cap"></i>
                    <span class="ip-label">{{localize 'WITCHER.Progression.ExpLabelShort'}}</span>
                    <span class="ip-value">{{system.improvementPoints}}</span>
                </div>
                
                <div class="ip-badge magic-ip open-rewards" data-action="openRewards" data-type="magic" data-tooltip="{{localize 'WITCHER.Progression.MagicIP'}}">
                    <i class="fas fa-sparkles"></i>
                    <span class="ip-label">{{localize 'WITCHER.Progression.MagicLabelShort'}}</span>
                    <span class="ip-value">{{system.magic.magicImprovementPoints}}</span>
                </div>
            </div>
        </div>

        <div class="header-metadata">
            <div class="meta-tags-group">
                <span class="meta-tag race" title="{{localize 'WITCHER.Actor.Race'}}">
                    <i class="fas fa-fingerprint"></i> {{#if race}}{{localize race.name}}{{else}}---{{/if}}
                </span>
                <span class="meta-tag profession" title="{{localize 'WITCHER.Actor.Prof'}}">
                    <i class="fas fa-briefcase"></i> {{#if profession}}{{localize profession.name}}{{else}}---{{/if}}
                </span>
            </div>
            
            <div class="meta-info-list">
                <button type="button" class="info-item background-lock-toggle {{#if system.general.backgroundLocked}}locked{{else}}unlocked{{/if}}"
                    data-action="toggleBackgroundLock"
                    title="{{#if system.general.backgroundLocked}}Sblocca Background e Professione/Razza{{else}}Blocca Background e Professione/Razza{{/if}}">
                    <i class="fas {{#if system.general.backgroundLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                    {{#if system.general.backgroundLocked}}Bloccato{{else}}Sbloccato{{/if}}
                </button>
                <div class="info-item" title="{{localize 'WITCHER.Homeland'}}">
                    <i class="fas fa-map-marker-alt"></i> {{#if system.general.homeland.value}}{{localize (lookup config.homelands system.general.homeland.value)}}{{else}}---{{/if}}
                </div>
                <div class="info-item" title="{{localize 'WITCHER.Actor.Age'}}">
                    <i class="fas fa-hourglass-half"></i> {{system.general.age}}
                </div>
                <div class="info-item" title="{{localize 'WITCHER.Actor.Gender.name'}}">
                    <i class="fas fa-venus-mars"></i> {{#if system.gender}}{{localize (concat 'WITCHER.Actor.Gender.' system.gender)}}{{else}}---{{/if}}
                </div>
                <div class="info-item weight {{#if (gt totalWeight system.derivedStats.enc.max)}}over-encumbered{{/if}}">
                    <i class="fas fa-weight-hanging"></i> {{totalWeight}} <small>/</small> {{system.derivedStats.enc.max}}
                </div>
            </div>
        </div>
    </div>
</div>
