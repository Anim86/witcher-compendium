<div class="crit-wound-section">
    <div class="section-header-premium">
        <div class="header-main">
            <i class="fas fa-biohazard header-icon"></i>
            <h3 class="header-name">{{localize "WITCHER.CritWound.Header"}}</h3>
            <div class="header-actions">
                <a class="btn-premium-action add-crit-wound" title="{{localize 'WITCHER.CritWound.Add'}}">
                    <i class="fas fa-plus"></i>
                    <span>{{localize "WITCHER.CritWound.Add"}}</span>
                </a>
            </div>
        </div>
    </div>

    <div class="critwounds-list">
        {{#each system.critWounds as |wound i|}}
        <div class="critwound-card {{ifThen wound.treated 'is-treated' (ifThen wound.stabilized 'is-stabilized' '')}}" data-index="{{i}}">
            <div class="critwound-main">
                <!-- Selection & Info -->
                <div class="critwound-selection">
                    <select name="system.critWounds.{{i}}.configEntry" class="wound-type">
                        <option value="">-- {{localize "WITCHER.CritWound.Add"}} --</option>
                        {{#each ../config.Crit as |c key|}}
                        <option value="{{key}}" {{selected (eq wound.configEntry key)}}>{{localize c.name}}</option>
                        {{/each}}
                    </select>
                    
                    <select name="system.critWounds.{{i}}.location" class="wound-location">
                        {{#select wound.location}}
                        <option value="head">{{localize "WITCHER.Location.Head"}}</option>
                        <option value="torso">{{localize "WITCHER.Location.Torso"}}</option>
                        <option value="rarm">{{localize "WITCHER.Location.RArm"}}</option>
                        <option value="larm">{{localize "WITCHER.Location.LArm"}}</option>
                        <option value="rleg">{{localize "WITCHER.Location.RLeg"}}</option>
                        <option value="lleg">{{localize "WITCHER.Location.LLeg"}}</option>
                        {{/select}}
                    </select>
                </div>

                <!-- Healing Progress -->
                <div class="healing-timer" title="{{localize 'WITCHER.CritWound.HealingTime.Label'}}">
                    <i class="fas fa-hourglass-half"></i>
                    <input type="number" name="system.critWounds.{{i}}.daysHealed" value="{{wound.daysHealed}}" placeholder="0">
                    <span class="sep">/</span>
                    <input type="number" name="system.critWounds.{{i}}.healingTime" value="{{wound.healingTime}}" placeholder="0">
                </div>

                <!-- Status Toggles -->
                <div class="toggle-group">
                    <label class="premium-checkbox {{ifThen wound.stabilized 'active' ''}}" title="{{localize 'WITCHER.CritWound.Stabilized'}}">
                        <input type="checkbox" name="system.critWounds.{{i}}.stabilized" {{checked wound.stabilized}}>
                        <i class="fas fa-band-aid"></i>
                    </label>
                    <label class="premium-checkbox {{ifThen wound.treated 'active' ''}}" title="{{localize 'WITCHER.CritWound.Treated'}}">
                        <input type="checkbox" name="system.critWounds.{{i}}.treated" {{checked wound.treated}}>
                        <i class="fas fa-briefcase-medical"></i>
                    </label>
                </div>

                <!-- Actions -->
                <div class="critwound-actions">
                    <a class="action-icon delete delete-crit-wound" title="{{localize 'WITCHER.Button.Delete'}}">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </div>

            <!-- Penalties & Notes (Sempre Visibili e Compatti) -->
            <div class="critwound-footer">
                {{#if wound.configEntry}}
                <div class="penalty-line">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span class="penalty-text">{{{localize (lookup (lookup ../config.Crit wound.configEntry) "penaltyDef")}}}</span>
                </div>
                {{/if}}
                <div class="notes-line">
                    <i class="fas fa-pen-nib"></i>
                    <input type="text" name="system.critWounds.{{i}}.notes" value="{{wound.notes}}" placeholder="{{localize 'WITCHER.CritWound.NotesPlaceholder'}}">
                </div>
            </div>
        </div>
    {{/each}}
</div>