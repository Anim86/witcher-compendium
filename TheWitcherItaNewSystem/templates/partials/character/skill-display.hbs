<a class="skill-card {{#if skill.isProfession}}is-profession{{else if skill.isPickup}}is-pickup{{else if skill.isLearned}}is-learned{{/if}}" 
   data-action="rollSkill" data-skill="{{name}}" data-stat={{stat}} 
   data-tooltip="
<div class='witcher-skill-tooltip'>
    <header class='skill-tooltip-header'>
        <h4>{{localize skill.label}}</h4>
    </header>
    <div class='skill-tooltip-body'>
        <div class='tooltip-stat-ref'>
            <span class='stat-label'>Statistica Chiave</span>
            <span class='stat-value'>{{localize (concat 'WITCHER.St' (capitalize stat))}} [{{lookup (lookup @root.system.stats stat) 'value'}}]</span>
        </div>
        <div class='tooltip-math-section'>
            <div class='tooltip-row'>
                <span><i class='fa-solid fa-book'></i> Livello Abilità</span>
                <span>{{skill.value}}</span>
            </div>
            {{#if skill.modifiersSum}}
            <div class='tooltip-row'>
                <span><i class='fa-solid fa-plus-minus'></i> Modificatori</span>
                {{#unless skill.modifierSources.length}}
                <span>{{#if (gt skill.modifiersSum 0)}}+{{/if}}{{skill.modifiersSum}}</span>
                {{/unless}}
            </div>
            {{#if skill.modifierSources.length}}
            <div class='tooltip-modifiers-list'>
                {{#each skill.modifierSources}}
                <div class='tooltip-row mod-source'>
                    <span>- {{this.source}}</span>
                    <span>{{#if (gt this.value 0)}}+{{/if}}{{this.value}}</span>
                </div>
                {{/each}}
            </div>
            {{/if}}
            {{/if}}
            <hr>
            <div class='tooltip-row total'>
                <span><i class='fa-solid fa-equals'></i> Valore Attuale</span>
                <span>{{skill.total}}</span>
            </div>
        </div>
    </div>
</div>
">
    <div class="skill-main">
        <span class="skill-label">{{localize skill.label}}</span>
    </div>
    <div class="skill-value-badge {{#if (gt skill.total skill.value)}}has-bonus{{else if (lt skill.total skill.value)}}has-penalty{{/if}}">
        {{#if (gte skill.total 0)}}+{{/if}}{{skill.total}}
        <span class="spend-ip-skill" data-tooltip="{{localize 'WITCHER.Progression.SpendIP'}}"><i class="fa-solid fa-plus"></i></span>
    </div>
</a>