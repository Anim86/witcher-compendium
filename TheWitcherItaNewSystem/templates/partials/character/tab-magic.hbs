<section class="tab {{tabs.magic.cssClass}} scrollable standard-form" data-group="primary" data-tab="magic">
    <nav class="sheet-tabs tabs">
        {{#each magicTabs as |tab|}}
            <a class="{{tab.cssClass}}" data-action="tab" data-group="magicTabs"
                data-tab="{{tab.id}}">{{localize tab.label}}</a>
        {{/each}}
    </nav>


    {{!-- 1. Spells (Incantesimi) --}}
    <section class="tab spell-section {{magicTabs.magic.cssClass}}" data-group="magicTabs" data-tab="magic">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=noviceSpells itemType='spell' spellType="spell" hasElement=true header=(concat (localize "WITCHER.Spell.Novice") " - " (localize "WITCHER.Spell.Spells"))}}
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=journeymanSpells itemType='spell' spellType="spell" hasElement=true header=(concat (localize "WITCHER.Spell.Journeyman") " - " (localize "WITCHER.Spell.Spells"))}}
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=masterSpells itemType='spell' spellType="spell" hasElement=true header=(concat (localize "WITCHER.Spell.Master") " - " (localize "WITCHER.Spell.Spells"))}}
    </section>

    {{!-- 2. Invocations (Invocazioni) --}}
    <section class="tab spell-section {{magicTabs.invocations.cssClass}}" data-group="magicTabs" data-tab="invocations">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=noviceInvocations itemType='spell' spellType="invocation" header=(concat (localize "WITCHER.Spell.Novice") " - " (localize "WITCHER.Spell.Invocations"))}}
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=journeymanInvocations itemType='spell' spellType="invocation" header=(concat (localize "WITCHER.Spell.Journeyman") " - " (localize "WITCHER.Spell.Invocations"))}}
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=masterInvocations itemType='spell' spellType="invocation" header=(concat (localize "WITCHER.Spell.Master") " - " (localize "WITCHER.Spell.Invocations"))}}
    </section>

    {{!-- 3. Witcher Signs (Segni) --}}
    <section class="tab spell-section {{magicTabs.signs.cssClass}}" data-group="magicTabs" data-tab="signs">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=basicSigns itemType='spell' spellType="signBasic" hasElement=true header=(concat (localize "WITCHER.Spell.Basic") " - " (localize "WITCHER.Spell.Signs"))}}
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=alternateSigns itemType='spell' spellType="signAlternate" hasElement=true header=(concat (localize "WITCHER.Spell.Alternate") " - " (localize "WITCHER.Spell.Signs"))}}
    </section>

    {{!-- 4. Rituals (Rituali) --}}
    <section class="tab magic-section {{magicTabs.rituals.cssClass}}" data-group="magicTabs" data-tab="rituals">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=rituals itemType='ritual' spellType="ritual" header=(localize "WITCHER.Spell.Rituals")}}
    </section>

    {{!-- 5. Hexes (Fatture) --}}
    <section class="tab magic-section {{magicTabs.hexes.cssClass}}" data-group="magicTabs" data-tab="hexes">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=hexes itemType='hex' spellType="hex" header=(localize "WITCHER.Spell.Hexes")}}
    </section>

    {{!-- 6. Magical Gift (Doni Magici) --}}
    <section class="tab magic-section {{magicTabs.magicalGift.cssClass}}" data-group="magicTabs" data-tab="magicalGift">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=magicalgift itemType='spell' spellType="magicalgift" header=(localize "WITCHER.Spell.MagicalGift")}}
    </section>

    {{!-- 7. Curses (Maledizioni) --}}
    <section class="tab magic-section {{magicTabs.curses.cssClass}}" data-group="magicTabs" data-tab="curses">
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/spell-type-list.hbs" spells=curses itemType='hex' spellType="curses" header=(localize "WITCHER.Spell.Curses")}}
    </section>
</section>
