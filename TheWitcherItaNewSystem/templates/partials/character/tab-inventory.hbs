<section class="tab {{tabs.inventory.cssClass}} scrollable standard-form" data-group="primary" data-tab="inventory">
    <div class="inventory-encumbrance-container {{#if (gt totalWeight encMax)}}overweight{{/if}}" 
         data-tooltip="<div class='weight-breakdown'>
            <div class='breakdown-title'>{{localize 'WITCHER.Loot.TotalWeight'}}</div>
            <div class='breakdown-item'><span>{{localize 'WITCHER.Loot.Weapons'}}:</span> <span>{{weightBreakdown.weapons}}kg</span></div>
            <div class='breakdown-item'><span>{{localize 'WITCHER.Loot.Armors'}}:</span> <span>{{weightBreakdown.armor}}kg</span></div>
            <div class='breakdown-item'><span>{{localize 'WITCHER.Actor.tabs.inventory'}}:</span> <span>{{weightBreakdown.inventory}}kg</span></div>
            <div class='breakdown-item'><span>{{localize 'TYPES.Item.container'}}:</span> <span>{{weightBreakdown.containers}}kg</span></div>
            <div class='breakdown-item'><span>{{localize 'WITCHER.Actor.rewards.currency'}}:</span> <span>{{weightBreakdown.currency}}kg</span></div>
            <hr>
            <div class='breakdown-item ev'><span>{{localize 'WITCHER.Armor.EncumbranceValue'}} (VIn):</span> <span>{{armorEV}}</span></div>
         </div>">
        <div class="enc-label">
            <span class="main-label"><i class="fas fa-weight-hanging"></i> {{localize "WITCHER.Loot.TotalWeight"}}</span>
            <span class="values">{{totalWeight}} / {{encMax}} <small>kg</small> ({{localize "WITCHER.Loot.LiftLimit"}}: {{liftLimit}} <small>kg</small>)</span>
        </div>
        <div class="enc-bar-wrapper">
            <div class="enc-bar-fill" style="width: {{encPct}}%;"></div>
        </div>
    </div>

    <div class="currency-bar">
        <div class="currency-item" data-tooltip="{{localize "WITCHER.Currency.crown"}}">
            <div class="coin-icon copper"><i class="fas fa-coins"></i></div>
            <span class="coin-label">{{localize "WITCHER.Currency.crown"}}</span>
            <div class="currency-input-wrapper">
                <input name="system.currency.crown" type="number" value="{{system.currency.crown}}" placeholder="0" data-dtype="Number" />
                <a class="adjust-currency" data-action="adjustCurrency" data-tooltip="Aggiungi/Sottrai Corone">
                    <i class="fa-solid fa-plus-minus"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="weapon-section">
        <div class="section-header valuable-header">
            <div></div>
            <h2>{{localize "WITCHER.Loot.Weapons"}}</h2>
            <div class="list-label">
                <span class="list-controls">
                    <a class="add-item" data-itemType="weapon" data-tooltip="{{localize 'WITCHER.Actor.Button.Add'}} {{localize 'TYPES.Item.weapon'}}">
                        <i class="fas fa-plus"></i>
                    </a>
                </span>
            </div>
        </div>
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-weapons.hbs" weapons=weapons itemType='weapon' header=(localize "WITCHER.Inventory.Weapons") hasDamage=true hasReliability=true hasQuantity=true}}
    </div>

    <div class="armor-section">
        <div class="section-header valuable-header">
            <div></div>
            <h2>{{localize "WITCHER.Loot.Armors"}}</h2>
            <div class="list-label">
                <span class="list-controls">
                    <a class="add-item" data-itemType="armor" data-tooltip="{{localize 'WITCHER.Actor.Button.Add'}} {{localize 'TYPES.Item.armor'}}">
                        <i class="fas fa-plus"></i>
                    </a>
                </span>
            </div>
        </div>
        {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-armors.hbs" armors=armors itemType='armor' header=(localize "WITCHER.Inventory.Armor") hasReliability=true hasQuantity=true}}
    </div>

    <div class="valuable-section">
        <div class="section-header valuable-header">
            <div></div>
            <h2>{{localize "WITCHER.Inventory.Valuables"}}</h2>
            <div class="list-label">
                <span class="list-controls">
                    <a class="add-item" data-itemType="valuable" data-tooltip="{{localize 'WITCHER.Actor.Button.Add'}} {{localize 'TYPES.Item.valuable'}}">
                        <i class="fas fa-plus"></i>
                    </a>
                </span>
            </div>
        </div>

        {{#if questItems}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=questItems header=(localize "WITCHER.Valuable.QuestItem") hasQuantity=true}}
        {{/if}}

        {{#if general}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=general header=(localize "WITCHER.Valuable.General") hasQuantity=true}}
        {{/if}}

        {{#if foodAndDrinks}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=foodAndDrinks header=(localize "WITCHER.Valuable.Food&Drinks") hasQuantity=true}}
        {{/if}}

        {{#if toolkits}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=toolkits header=(localize "WITCHER.Valuable.Toolkit") hasQuantity=true}}
        {{/if}}

        {{#if clothingAndContainers}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=clothingAndContainers header=(localize "WITCHER.Valuable.Clothings") hasQuantity=true}}
        {{/if}}

        {{#if mounts}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-mounts.hbs"  mounts=mounts header=(localize "WITCHER.Inventory.Mounts") hasQuantity=true}}
        {{/if}}

        {{#if mountAccessories}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=mountAccessories header=(localize "WITCHER.Valuable.MountAccessories") hasQuantity=true}}
        {{/if}}

        {{#if containers}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-valuables.hbs" valuables=containers header=(localize "WITCHER.Valuable.Containers") itemType="container" hasQuantity=true}}
        {{/if}}

        <div class="section-header valuable-header">
            <div></div>
            <h2>{{localize "WITCHER.Inventory.Diagrams"}}</h2>
            <div class="list-label">
                <span class="list-controls">
                    <a class="add-item" data-itemType="diagrams" data-tooltip="{{localize 'WITCHER.Actor.Button.Add'}} {{localize 'TYPES.Item.diagrams'}}">
                        <i class="fas fa-plus"></i>
                    </a>
                </span>
            </div>
        </div>
        {{#if alchemicalItemDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=alchemicalItemDiagrams header=(localize "WITCHER.Inventory.AlchemicalItemDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if oilDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=oilDiagrams header=(localize "WITCHER.Inventory.OilDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if potionDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=potionDiagrams header=(localize "WITCHER.Inventory.PotionDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if decoctionDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=decoctionDiagrams header=(localize "WITCHER.Inventory.DecoctionDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if ingredientDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=ingredientDiagrams header=(localize "WITCHER.Inventory.IngredientDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if ammunitionDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=ammunitionDiagrams header=(localize "WITCHER.Inventory.AmmunitionDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if weaponDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=weaponDiagrams header=(localize "WITCHER.Inventory.WeaponDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if enhancementDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=enhancementDiagrams header=(localize "WITCHER.Inventory.enhancementDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if armorDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=armorDiagrams header=(localize "WITCHER.Inventory.ArmorDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if elderfolkWeaponDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=elderfolkWeaponDiagrams header=(localize "WITCHER.Inventory.ElderfolkWeaponDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if elderfolkArmorDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=elderfolkArmorDiagrams header=(localize "WITCHER.Inventory.ElderfolkArmorDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if bombDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=bombDiagrams header=(localize "WITCHER.Inventory.BombDiagrams") hasQuantity=true}}
        {{/if}}

        {{#if trapDiagrams}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-diagrams.hbs" diagrams=trapDiagrams header=(localize "WITCHER.Inventory.TrapDiagrams") hasQuantity=true}}
        {{/if}}
    </div>

    <div class="component-section">
        <div class="section-header valuable-header">
            <div></div>
            <h2>{{localize "WITCHER.Inventory.Alchemy"}}</h2>
            <div class="list-label">
                <span class="list-controls">
                    <a class="add-item" data-itemType="alchemical" data-tooltip="{{localize 'WITCHER.Actor.Button.Add'}} {{localize 'TYPES.Item.alchemical'}}">
                        <i class="fas fa-plus"></i>
                    </a>
                </span>
            </div>
        </div>

        {{#if alchemicalItems}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-alchemical.hbs" alchemicals=alchemicalItems header=(localize "WITCHER.Inventory.AlchemicalItems") hasQuantity=true}}
        {{/if}}

        {{#if oils}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-alchemical.hbs" alchemicals=oils header=(localize "WITCHER.Inventory.Oils") hasQuantity=true}}
        {{/if}}

        {{#if witcherPotions}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-alchemical.hbs" alchemicals=witcherPotions header=(localize "WITCHER.Inventory.WitcherPotionsAndDecoctions") hasQuantity=true}}
        {{/if}}

        {{#if mutagens}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-alchemical.hbs" alchemicals=mutagens itemType='mutagen' header=(localize "WITCHER.Inventory.Mutagens") hasQuantity=true}}
        {{/if}}

        {{#if alchemicalTreatments}}
            {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-components.hbs" components=alchemicalTreatments header=(localize "WITCHER.Inventory.AlchemicalTreatments") hasQuantity=true}}
        {{/if}}

        <div>
            {{> "systems/TheWitcherItaNewSystem/templates/partials/character/substances.hbs"}}
        </div>

        <div class="section-header valuable-header">
            <div></div>
            <h2>{{localize "WITCHER.Inventory.Crafting"}}</h2>
            <div class="list-label">
                <span class="list-controls">
                    <a class="add-item" data-itemType="component" data-tooltip="{{localize 'WITCHER.Actor.Button.Add'}} {{localize 'TYPES.Item.component'}}">
                        <i class="fas fa-plus"></i>
                    </a>
                </span>
            </div>
        </div>
        <div class="components">
            {{#if craftingMaterials}}
                {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-components.hbs" components=craftingMaterials header=(localize "WITCHER.Inventory.CraftingMaterials") hasQuantity=true}}
            {{/if}}

            {{#if ingotsAndMinerals}}
                {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-components.hbs" components=ingotsAndMinerals header=(localize "WITCHER.Inventory.IngotsAndMinerals") hasQuantity=true}}
            {{/if}}

            {{#if hidesAndAnimalParts}}
                {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-components.hbs" components=hidesAndAnimalParts header=(localize "WITCHER.Inventory.HidesAndAnimalParts") hasQuantity=true}}
            {{/if}}

            {{#if runeItems}}
                {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-runes-glyphs.hbs" enhancements=runeItems header=(localize "WITCHER.Inventory.Runes") hasQuantity=true}}
            {{/if}}
            {{#if glyphItems}}
                {{> "systems/TheWitcherItaNewSystem/templates/sheets/actor/partials/character/inventory/tab-inventory-runes-glyphs.hbs" enhancements=glyphItems header=(localize "WITCHER.Inventory.Glyphs") hasQuantity=true}}
            {{/if}}
        </div>
    </div>
</section>
