<section class="tab {{tabs.background.cssClass}} scrollable standard-form" data-group="primary" data-tab="background">
    <div class="tab body background">
        <div class="background-profile-panel">
            <div class="background-profile-field">
                <span class="background-profile-icon"><i class="fa-solid fa-venus-mars"></i></span>
                <label>{{localize 'WITCHER.Actor.Gender.name'}}</label>
                <select name="system.gender">
                    {{selectOptions config.genders selected=system.gender localize=true}}
                </select>
            </div>

            <div class="background-profile-field">
                <span class="background-profile-icon"><i class="fa-solid fa-map-location-dot"></i></span>
                <label>Regione d'Origine</label>
                <select name="system.general.originRegion">
                    {{selectOptions config.originRegions selected=backgroundOriginRegion}}
                </select>
            </div>

            <div class="background-profile-field">
                <span class="background-profile-icon"><i class="fa-solid fa-flag"></i></span>
                <label>Patria</label>
                <div class="background-profile-homeland">
                    <select name="system.general.homeland.value">
                        {{selectOptions config.homelands selected=backgroundHomelandValue localize=true}}
                    </select>
                    {{#if (eq backgroundHomelandValue "other")}}
                        <input name="system.general.homeland.otherValue" type="text"
                            value="{{system.general.homeland.otherValue}}" />
                    {{/if}}
                </div>
            </div>

            <div class="background-profile-field background-profile-field-age">
                <span class="background-profile-icon"><i class="fa-solid fa-hourglass-half"></i></span>
                <label>{{localize 'WITCHER.Actor.Age'}}</label>
                <input name="system.general.age" type="number" value="{{system.general.age}}"
                    placeholder="0" data-dtype="Number" />
            </div>
        </div>

        {{#if race}}
            <div class="background-standing-panel item" data-item-id="{{race._id}}">
                <div class="background-standing-field">
                    <label>Nord</label>
                    <select class="inline-edit" data-field="system.socialStanding.north">
                        {{selectOptions config.socialStanding selected=race.system.socialStanding.north localize=true}}
                    </select>
                </div>

                <div class="background-standing-field">
                    <label>Nilfgaard</label>
                    <select class="inline-edit" data-field="system.socialStanding.nilfgaard">
                        {{selectOptions config.socialStanding selected=race.system.socialStanding.nilfgaard localize=true}}
                    </select>
                </div>

                <div class="background-standing-field">
                    <label>Skellige</label>
                    <select class="inline-edit" data-field="system.socialStanding.skellige">
                        {{selectOptions config.socialStanding selected=race.system.socialStanding.skellige localize=true}}
                    </select>
                </div>

                <div class="background-standing-field">
                    <label>Dol Blathanna</label>
                    <select class="inline-edit" data-field="system.socialStanding.dolBlathanna">
                        {{selectOptions config.socialStanding selected=race.system.socialStanding.dolBlathanna localize=true}}
                    </select>
                </div>

                <div class="background-standing-field">
                    <label>Mahakam</label>
                    <select class="inline-edit" data-field="system.socialStanding.mahakam">
                        {{selectOptions config.socialStanding selected=race.system.socialStanding.mahakam localize=true}}
                    </select>
                </div>
            </div>
        {{/if}}

        <div class="background-family-panel">
            <div class="background-family-field">
                <span class="background-family-icon"><i class="fa-solid fa-house-chimney"></i></span>
                <label>Stato della Famiglia</label>
                <select name="system.general.background.familyState">
                    <option value="">-- Seleziona --</option>
                    <option value="alive" {{#if (eq system.general.background.familyState "alive")}}selected{{/if}}>Almeno parte della famiglia è ancora viva.</option>
                    <option value="something_happened" {{#if (eq system.general.background.familyState "something_happened")}}selected{{/if}}>Qualcosa è Accaduto alla Famiglia</option>
                </select>
            </div>

            {{#if (eq system.general.background.familyState "something_happened")}}
                <div class="background-family-field background-family-field-wide">
                    <span class="background-family-icon"><i class="fa-solid fa-scroll"></i></span>
                    <label>Sorte della Famiglia</label>
                    <textarea name="system.general.background.familyFate" rows="3">{{system.general.background.familyFate}}</textarea>
                </div>
            {{/if}}

            {{#if (eq system.general.background.familyState "alive")}}
                <div class="background-family-field">
                    <span class="background-family-icon"><i class="fa-solid fa-user-group"></i></span>
                    <label>Stato dei Genitori</label>
                    <select name="system.general.background.parentsState">
                        <option value="">-- Seleziona --</option>
                        <option value="alive" {{#if (eq system.general.background.parentsState "alive")}}selected{{/if}}>Genitori Vivi</option>
                        <option value="something_happened" {{#if (eq system.general.background.parentsState "something_happened")}}selected{{/if}}>Qualcosa è Accaduto ai Genitori</option>
                    </select>
                </div>

                {{#if (eq system.general.background.parentsState "something_happened")}}
                    <div class="background-family-field background-family-field-wide">
                        <span class="background-family-icon"><i class="fa-solid fa-scroll"></i></span>
                        <label>Sorte dei Genitori</label>
                        <textarea name="system.general.background.parentsFate" rows="3">{{system.general.background.parentsFate}}</textarea>
                    </div>
                {{/if}}

                {{#if (eq system.general.background.parentsState "alive")}}
                    <div class="background-family-field background-family-field-wide">
                        <span class="background-family-icon"><i class="fa-solid fa-people-roof"></i></span>
                        <label>Situazione Familiare</label>
                        <textarea name="system.general.background.socialStatus" rows="4">{{system.general.background.socialStatus}}</textarea>
                    </div>
                {{/if}}
            {{/if}}
        </div>

        {{#if backgroundLifeEvents.length}}
            <div class="background-events-panel">
                <div class="background-events-title">
                    <span class="background-events-title-icon"><i class="fa-solid fa-timeline"></i></span>
                    <h3>Eventi della Vita</h3>
                    <span class="background-events-count">{{backgroundLifeEvents.length}}</span>
                </div>

                <div class="background-events-timeline">
                    {{#each backgroundLifeEvents}}
                        <article class="background-event-card">
                            <div class="background-event-marker">
                                <span>{{key}}</span>
                                <small>anni</small>
                            </div>
                            <div class="background-event-body">
                                <div class="background-event-heading">Evento della Vita</div>
                                {{#if value}}
                                    <div class="background-event-text">{{{value}}}</div>
                                {{/if}}
                                {{#if details}}
                                    <div class="background-event-details">{{details}}</div>
                                {{/if}}
                            </div>
                        </article>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    </div>
</section>
