<section class="tab {{tabs.stats.cssClass}} standard-form" data-group="primary" data-tab="stats">
    <div class='character-statistics'>
        <div class='char-stat-title'>
            <i class="fa-solid fa-trophy"></i>
            <span class="sheet-label-box">{{localize 'WITCHER.Actor.StatTitle.Attributes'}}</span>
            <a data-action="openModifiers" data-type="stats" data-tooltip="{{localize 'WITCHER.Resources.modifiers'}}"><i class="fas fa-edit"></i></a>
        </div>
        
        <div class='stat-grid'>
            {{#each system.stats as |details stat|}}
                {{#unless (eq (localize details.label) (localize 'WITCHER.Actor.Stat.Toxicity'))}}
                    <a class='stat-display char-stat-button stat-roll stat-card-{{stat}}' data-stat='{{stat}}'
                        data-tooltip="{{localize (concat 'WITCHER.Actor.Stat.Desc.' stat)}}">
                        <div class="stat-icon">
                             {{#if (eq stat 'int')}}<i class="fa-solid fa-brain"></i>{{/if}}
                             {{#if (eq stat 'ref')}}<i class="fa-solid fa-person-running"></i>{{/if}}
                             {{#if (eq stat 'dex')}}<i class="fa-solid fa-arrows-to-dot"></i>{{/if}}
                             {{#if (eq stat 'body')}}<i class="fa-solid fa-child"></i>{{/if}}
                             {{#if (eq stat 'spd')}}<i class="fa-solid fa-bolt"></i>{{/if}}
                             {{#if (eq stat 'emp')}}<i class="fa-solid fa-heart"></i>{{/if}}
                             {{#if (eq stat 'cra')}}<i class="fa-solid fa-hammer"></i>{{/if}}
                             {{#if (eq stat 'will')}}<i class="fa-solid fa-fire"></i>{{/if}}
                             {{#if (eq stat 'luck')}}<i class="fa-solid fa-clover"></i>{{/if}}
                        </div>
                        <div class="stat-content">
                            <div class="label">
                                <span>{{localize details.label}}</span>
                                <span class="current-val">{{#if (gte details.value 0)}}+{{/if}}{{details.value}}</span>
                            </div>
                            <div class="mod" data-tooltip="{{localize 'WITCHER.Actor.StatTitle.ModMax'}}">
                                <span class="max">{{details.max}}</span>
                                <span class="divider">/</span>
                                <span class="stat-mod {{#if (gt details.value details.max)}}stat-mod-plus{{else if (eq details.value details.max)}}stat-mod-zero{{else}}stat-mod-minus{{/if}}">
                                    {{#if (gte (formatModLabel details.value details.max) 0)}}+{{/if}}{{formatModLabel details.value details.max}}
                                </span>
                            </div>
                        </div>
                    </a>
                {{/unless}}
            {{/each}}


             <div class='stat-display char-stat-button total-stats' data-tooltip="{{localize 'WITCHER.Actor.Stat.Desc.TotalStats'}}">
                <div class="stat-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div class="stat-content">
                    <div class="label">
                        <span>{{localize 'WITCHER.Actor.TotalStats'}}</span>
                        <span class="current-val">{{totalStats}}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class='core-stats-list'>
        <div class='char-stat-title'>
            <i class="fa-solid fa-microchip"></i>
            <span class="sheet-label-box">{{localize 'WITCHER.Actor.StatTitle.DerStat'}}</span>
            <a data-action="openModifiers" data-type="derivedStats" data-tooltip="{{localize 'WITCHER.Resources.modifiers'}}"><i class="fas fa-edit"></i></a>
        </div>
        <div class='stat-grid'>
            {{#each system.derivedStats as |details derStat|}}
                <div class='stat-display char-derived-button der-card-{{derStat}}' data-type='derStat' data-stat='{{derStat}}'
                    data-tooltip="{{#if (localize (concat 'WITCHER.Actor.DerStat.Desc.' derStat))}}{{localize (concat 'WITCHER.Actor.DerStat.Desc.' derStat)}}{{else}}{{localize details.label}}{{/if}}">
                    <div class="stat-icon">
                        {{#if (eq derStat 'stun')}}<i class="fa-solid fa-fainting-face"></i>{{/if}}
                        {{#if (eq derStat 'run')}}<i class="fa-solid fa-wind"></i>{{/if}}
                        {{#if (eq derStat 'leap')}}<i class="fa-solid fa-up-long"></i>{{/if}}
                        {{#if (eq derStat 'hp')}}<i class="fa-solid fa-heart"></i>{{/if}}
                        {{#if (eq derStat 'sta')}}<i class="fa-solid fa-bolt"></i>{{/if}}
                        {{#if (eq derStat 'vigor')}}<i class="fa-solid fa-hand-holding-hand"></i>{{/if}}
                        {{#if (eq derStat 'enc')}}<i class="fa-solid fa-weight-hanging"></i>{{/if}}
                        {{#if (eq derStat 'rec')}}<i class="fa-solid fa-medkit"></i>{{/if}}
                        {{#if (eq derStat 'resolve')}}<i class="fa-solid fa-shield-heart"></i>{{/if}}
                        {{#if (eq derStat 'focus')}}<i class="fa-solid fa-eye"></i>{{/if}}
                    </div>
                    <div class="stat-content">
                        <div class="label">
                            <span>{{localize details.label}}</span>
                            <span class="current-val">{{#if (gte details.value 0)}}+{{/if}}{{details.value}}</span>
                        </div>
                        <div class="mod" data-tooltip="{{localize 'WITCHER.Actor.StatTitle.ModMax'}}">
                            <span class="max">{{details.max}}</span>
                            <span class="divider">/</span>
                            <span class="stat-mod {{#if (gt details.value details.max)}}stat-mod-plus{{else if (eq details.value details.max)}}stat-mod-zero{{else}}stat-mod-minus{{/if}}">
                                {{#if (gte (formatModLabel details.value details.max) 0)}}+{{/if}}{{formatModLabel details.value details.max}}
                            </span>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</section>