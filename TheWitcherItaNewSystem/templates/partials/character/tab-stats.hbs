<section class="tab {{tabs.stats.cssClass}} standard-form" data-group="primary" data-tab="stats">
    <!-- Quick Actions were moved back to Sidebar -->

    <div class='character-statistics'>
        <div class='char-stat-title'>
            <i class="fa-solid fa-trophy"></i>
            <span class="sheet-label-box">{{localize 'WITCHER.Actor.StatTitle.Attributes'}}</span>
            <a data-action="openModifiers" data-type="stats" data-tooltip="{{localize 'WITCHER.Resources.modifiers'}}"><i class="fas fa-edit"></i></a>
        </div>
        
        <div class='stat-grid'>
            {{#each system.stats as |details stat|}}
                {{#unless (eq (localize details.label) (localize 'WITCHER.Actor.Stat.Toxicity'))}}
                    <a class='stat-display char-stat-button stat-roll stat-card-{{stat}} {{#if (lookup @root.penalizedStats stat)}}penalty-active{{/if}}' data-stat='{{stat}}'
                        data-tooltip="
<div class='witcher-skill-tooltip'>
    <header class='skill-tooltip-header'>
        <h4>{{localize details.label}}</h4>
    </header>
    <div class='skill-tooltip-body'>
        <div class='tooltip-stat-ref' style='justify-content: center; text-align: center; font-style: italic; font-weight: 400;'>
            {{localize (concat 'WITCHER.Actor.Stat.Desc.' stat)}}
        </div>
        <div class='tooltip-math-section'>
            <div class='tooltip-row'>
                <span><i class='fa-solid fa-arrow-up-right-dots'></i> Valore Base</span>
                <span>{{details.unmodifiedMax}}</span>
            </div>
            {{#with (lookup @root.statBreakdowns stat) as |breakdown|}}
            {{#if breakdown.hasModifiers}}
            <div class='tooltip-row'>
                <span><i class='fa-solid fa-plus-minus'></i> Modificatori</span>
                <span class='{{#if (gt details.totalModifiers 0)}}bonus-text{{else}}penalty-text{{/if}}'>{{#if (gt details.totalModifiers 0)}}+{{/if}}{{details.totalModifiers}}</span>
            </div>
            <div class='tooltip-breakdown-list'>
                {{#each breakdown.modifiers}}
                <div class='breakdown-item'>
                    <span class='breakdown-source'>{{name}}</span>
                    <span class='breakdown-val {{#if (gt value 0)}}bonus{{else}}penalty{{/if}}'>{{#if (gt value 0)}}+{{/if}}{{value}}</span>
                </div>
                {{/each}}
                {{#each breakdown.dividers}}
                <div class='breakdown-item'>
                    <span class='breakdown-source'>{{name}} (Divisore)</span>
                    <span class='breakdown-val penalty'>/ {{value}}</span>
                </div>
                {{/each}}
            </div>
            {{/if}}
            {{/with}}
            <div class='tooltip-row total-row'>
                <span>Valore Attuale</span>
                <span class='total-val'>{{details.value}}</span>
            </div>
        </div>
    </div>
</div>">
                        <div class="stat-icon">
                             {{#if (eq stat 'int')}}<i class="fa-solid fa-brain"></i>{{/if}}
                             {{#if (eq stat 'ref')}}<i class="fa-solid fa-person-running"></i>{{/if}}
                             {{#if (eq stat 'dex')}}<i class="fa-solid fa-arrows-to-dot"></i>{{/if}}
                             {{#if (eq stat 'body')}}<i class="fa-solid fa-child"></i>{{/if}}
                             {{#if (eq stat 'spd')}}<i class="fa-solid fa-bolt"></i>{{/if}}
                             {{#if (eq stat 'emp')}}<i class="fa-solid fa-heart"></i>{{/if}}
                             {{#if (eq stat 'cra')}}<i class="fa-solid fa-hammer"></i>{{/if}}
                             {{#if (eq stat 'will')}}<i class="fa-solid fa-fire"></i>{{/if}}
                             {{#if (eq stat 'luck')}}<i class="fa-solid fa-clover"></i>{{/if}}
                        </div>
                        <div class="stat-content">
                            <div class="label">
                                <span class="stat-name">{{localize details.label}}</span>
                                <span class="current-val">
                                    {{details.value}}
                                    <span class="spend-ip-stat" data-tooltip="{{localize 'WITCHER.Progression.SpendIP'}}"><i class="fa-solid fa-plus"></i></span>
                                </span>
                            </div>
                            <div class="stat-sub">
                                {{details.unmodifiedMax}} 
                                <span class="modifier {{#if (or (lt details.totalModifiers 0) (gt details.totalDivider 1))}}penalty{{else if (gt details.totalModifiers 0)}}bonus{{/if}}">
                                    ({{#if (gt details.totalModifiers 0)}}+{{/if}}{{details.totalModifiers}})
                                </span>
                            </div>
                        </div>
                    </a>
                {{/unless}}
            {{/each}}


             <div class='stat-display char-stat-button total-stats' data-tooltip="{{localize 'WITCHER.Actor.Stat.Desc.TotalStats'}}">
                <div class="stat-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div class="stat-content">
                    <div class="label">
                        <span>{{localize 'WITCHER.Actor.TotalStats'}}</span>
                        <span class="current-val">{{totalStats}}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class='core-stats-list'>
        <div class='char-stat-title'>
            <i class="fa-solid fa-microchip"></i>
            <span class="sheet-label-box">{{localize 'WITCHER.Actor.StatTitle.DerStat'}}</span>
            <a data-action="openModifiers" data-type="derivedStats" data-tooltip="{{localize 'WITCHER.Resources.modifiers'}}"><i class="fas fa-edit"></i></a>
        </div>
        <div class='stat-grid'>
            {{#each system.derivedStats as |details derStat|}}
                {{#unless (eq derStat 'liftLimit')}}
                    <div class='stat-display char-derived-button der-card-{{derStat}}' data-type='derStat' data-stat='{{derStat}}'
                        data-tooltip="
<div class='witcher-skill-tooltip'>
    <header class='skill-tooltip-header'>
        <h4>{{localize details.label}}</h4>
    </header>
    <div class='skill-tooltip-body'>
        <div class='tooltip-stat-ref' style='justify-content: center; text-align: center; font-style: italic; font-weight: 400;'>
            {{#if (localize (concat 'WITCHER.Actor.DerStat.Desc.' derStat))}}{{localize (concat 'WITCHER.Actor.DerStat.Desc.' derStat)}}{{else}}{{localize details.label}}{{/if}}
        </div>
        <div class='tooltip-math-section'>
            <div class='tooltip-row'>
                <span><i class='fa-solid fa-arrow-up-right-dots'></i> Valore Base</span>
                <span>{{details.max}}</span>
            </div>
            {{#with (lookup @root.statBreakdowns derStat) as |breakdown|}}
            {{#if breakdown.hasModifiers}}
            <div class='tooltip-row'>
                <span><i class='fa-solid fa-plus-minus'></i> Modificatori</span>
                <span class='{{#if (gt details.totalModifiers 0)}}bonus-text{{else}}penalty-text{{/if}}'>{{#if (gt details.totalModifiers 0)}}+{{/if}}{{details.totalModifiers}}</span>
            </div>
            <div class='tooltip-breakdown-list'>
                {{#each breakdown.modifiers}}
                <div class='breakdown-item'>
                    <span class='breakdown-source'>{{name}}</span>
                    <span class='breakdown-val {{#if (gt value 0)}}bonus{{else}}penalty{{/if}}'>{{#if (gt value 0)}}+{{/if}}{{value}}</span>
                </div>
                {{/each}}
                {{#each breakdown.dividers}}
                <div class='breakdown-item'>
                    <span class='breakdown-source'>{{name}} (Divisore)</span>
                    <span class='breakdown-val penalty'>/ {{value}}</span>
                </div>
                {{/each}}
            </div>
            {{/if}}
            {{/with}}
            <div class='tooltip-row total-row'>
                <span>Valore Attuale</span>
                <span class='total-val'>{{details.value}} / {{details.max}}</span>
            </div>
        </div>
    </div>
</div>">
                        <div class="stat-icon">
                            {{#if (eq derStat 'stun')}}<i class="fa-solid fa-face-dizzy"></i>{{/if}}
                            {{#if (eq derStat 'run')}}<i class="fa-solid fa-wind"></i>{{/if}}
                            {{#if (eq derStat 'leap')}}<i class="fa-solid fa-up-long"></i>{{/if}}
                            {{#if (eq derStat 'hp')}}<i class="fa-solid fa-heart"></i>{{/if}}
                            {{#if (eq derStat 'sta')}}<i class="fa-solid fa-bolt"></i>{{/if}}
                            {{#if (eq derStat 'vigor')}}<i class="fa-solid fa-hand-holding-hand"></i>{{/if}}
                            {{#if (eq derStat 'enc')}}<i class="fa-solid fa-weight-hanging"></i>{{/if}}
                            {{#if (eq derStat 'rec')}}<i class="fa-solid fa-suitcase-medical"></i>{{/if}}
                            {{#if (eq derStat 'resolve')}}<i class="fa-solid fa-shield-heart"></i>{{/if}}
                            {{#if (eq derStat 'focus')}}<i class="fa-solid fa-eye"></i>{{/if}}
                            {{#if (eq derStat 'shield')}}<i class="fa-solid fa-shield-halved"></i>{{/if}}
                            {{#if (eq derStat 'woundTreshold')}}<i class="fa-solid fa-droplet-slash"></i>{{/if}}
                        </div>
                        <div class="stat-content">
                            <div class="label">
                                <span class="stat-name">{{localize details.label}}</span>
                                <span class="current-val">{{details.value}}</span>
                            </div>
                            <div class="stat-sub">
                                {{details.max}} 
                                <span class="modifier {{#if (lt details.totalModifiers 0)}}penalty{{else if (gt details.totalModifiers 0)}}bonus{{/if}}">
                                    ({{#if (gt details.totalModifiers 0)}}+{{/if}}{{details.totalModifiers}})
                                </span>
                            </div>
                        </div>
                    </div>
                {{/unless}}
            {{/each}}
        </div>
    </div>
    
</section>