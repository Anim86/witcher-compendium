<header class="item-header">
    <h1 class="itemname">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'WITCHER.Name'}}" />
        {{#if showConfig}}
            <a class="configure-item" data-action="configureItem"><i class="fas fa-gear"></i></a>
        {{/if}}
    </h1>
    <general>
        <itemimage>
            {{#if (and (includes (getSetting "clickableImageItemTypes") item.type)  (or (window "game" "user" "isGM") (eq (getSetting "clickableImageCheckboxForGMOnly") false)) )}}
                <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img"
                    title="{{item.name}}" />
                <div>
                    <input type="checkbox" id="clickable-image-{{item._id}}" name="system.clickableImage"
                        {{checked item.system.clickableImage}}>
                    <label for="clickable-image-{{item._id}}">{{localize "WITCHER.Item.ClickableImage"}}</label>
                </div>
            {{else}}
                <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img"
                    title="{{item.name}}" />
            {{/if}}
        </itemimage>

        <div class="information-grid">
            <div class="info-item">
                <label>{{localize "WITCHER.Item.Quantity"}}</label>
                <input type="text" name="system.quantity" value="{{item.system.quantity}}" data-dtype="Number" />
            </div>
            <div class="info-item">
                <label>{{localize "WITCHER.Item.Weight"}}</label>
                <input type="text" name="system.weight" value="{{item.system.weight}}" data-dtype="Number" />
            </div>
            {{#if (eq item.type "mutagen")}}
            <div class="info-item">
                <label>{{localize "WITCHER.Type"}}</label>
                <select name="system.type" id="type-select">
                    {{selectOptions config.type selected=item.system.type localize=true}}
                </select>
            </div>
            {{/if}}
            {{#unless (eq item.type "mutagen")}}
            <div class="info-item">
                <label>{{localize "WITCHER.Item.Cost"}}</label>
                <input type="text" name="system.cost" value="{{item.system.cost}}" data-dtype="Number" />
            </div>
            {{/unless}}
            <div class="info-item info-full">
                <label>{{localize "WITCHER.Item.SourceBook"}}</label>
                <input type="text" name="system.sourcebook" value="{{item.system.sourcebook}}" />
            </div>
        </div>
    </general>
</header>