                {{else}}
                    <a class="skill-display">{{localize "WITCHER.Actor.Skill.Dexterity"}}
                        <i class="expander fas fa-chevron-right"></i></a>
                {{/if}}
            </div>
            <table {{#if system.pannels.dexIsOpen}} class="skill-list" {{else}} class="skill-list invisible" {{/if}}>
                {{#each system.skills.dex as |skill name|}}
                    {{> "systems/TheWitcherItaNewSystem/templates/partials/monster/monster-skill-display.hbs" skill=skill name=name stat="dex"}}
                {{/each}}
                {{#each customSkills.dex}}
                    {{> "systems/TheWitcherItaNewSystem/templates/partials/monster/monster-custom-skill-display.hbs"}}
                {{/each}}
            </table>
        </div>
    </div>
