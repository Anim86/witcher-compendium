<div class="monster-tab-content monster-details-layout">
    {{!-- Left Column: Ecology & Biometrics --}}
    <div class="details-column">
        <section class="details-section ecology card">
            <h3 class="section-header"><i class="fas fa-leaf"></i> {{localize "WITCHER.Monster.Environment"}}</h3>
            <div class="details-grid">
                <div class="detail-item">
                    <label>{{localize "WITCHER.Monster.Environment"}}</label>
                    <input name="system.environment" type="text" value="{{system.environment}}" />
                </div>
                <div class="detail-item">
                    <label>{{localize "WITCHER.Monster.Organization"}}</label>
                    <input name="system.organization" type="text" value="{{system.organization}}" />
                </div>
                <div class="detail-item">
                    <label>{{localize "WITCHER.Monster.Height"}}</label>
                    <input name="system.height" type="text" value="{{system.height}}" />
                </div>
                <div class="detail-item">
                    <label>{{localize "WITCHER.Monster.Weight"}}</label>
                    <input name="system.weight" type="text" value="{{system.weight}}" />
                </div>
            </div>
        </section>

        <section class="details-section vulnerabilities card">
            <h3 class="section-header"><i class="fas fa-biohazard"></i> {{localize "WITCHER.Monster.Vulnerabilities"}} &amp; {{localize "WITCHER.Monster.Resistances"}}</h3>
            <div class="vuln-res-container">
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.Vulnerabilities"}}</label>
                    <textarea name="system.vulnerability" rows="3">{{system.vulnerability}}</textarea>
                </div>
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.Resistances"}}</label>
                    <textarea name="system.resistances" rows="3">{{system.resistances}}</textarea>
                </div>
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.Immunities"}}</label>
                    <textarea name="system.immunities" rows="2">{{system.immunities}}</textarea>
                </div>
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.Susceptibilities"}}</label>
                    <textarea name="system.susceptibilities" rows="2">{{system.susceptibilities}}</textarea>
                </div>
            </div>
        </section>
    </div>

    {{!-- Right Column: Knowledge & Description --}}
    <div class="details-column">
        <section class="details-section knowledge card">
            <h3 class="section-header"><i class="fas fa-scroll"></i> {{localize "WITCHER.Monster.Superstition"}}</h3>
            <div class="knowledge-container">
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.CommonerSuperstition"}}</label>
                    <textarea name="system.common" rows="3">{{system.common}}</textarea>
                </div>
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.AcademicKnowledge"}}</label>
                    <textarea name="system.academicKnowledge" rows="3">{{system.academicKnowledge}}</textarea>
                </div>
                <div class="text-block">
                    <label>{{localize "WITCHER.Monster.WitcherKnowledge"}}</label>
                    <textarea name="system.monsterLore" rows="3">{{system.monsterLore}}</textarea>
                </div>
            </div>
        </section>

        <section class="details-section biography card">
            <h3 class="section-header"><i class="fas fa-book-open"></i> {{localize "WITCHER.Description"}}</h3>
            <div class="bio-container">
                {{editor system.description target="system.description" button=true owner=owner editable=editable}}
            </div>
        </section>
    </div>

    {{!-- Full Width Bottom Section: Special Abilities --}}
    <div class="details-footer">
        <section class="details-section abilities card">
            <h3 class="section-header"><i class="fas fa-star"></i> {{localize "WITCHER.Monster.SpecialAbilities"}}</h3>
            <div class="abilities-grid">
                {{#each abilities as |ability id|}}
                <div class="ability-item item" data-item-id="{{ability.id}}">
                    <div class="ability-header">
                        <img src="{{ability.img}}" class="ability-icon" />
                        <span class="ability-name">{{ability.name}}</span>
                        <div class="ability-actions">
                            <a class="item-action item-edit" title="{{localize 'WITCHER.Button.Edit'}}"><i class="fas fa-edit"></i></a>
                            <a class="item-action item-delete" title="{{localize 'WITCHER.Button.Delete'}}"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    <div class="ability-description">
                        {{{ability.system.description}}}
                    </div>
                </div>
                {{/each}}
                {{#unless abilities}}
                <p class="no-data">{{localize "WITCHER.Monster.NoSpecialAbilities"}}</p>
                {{/unless}}
            </div>
        </section>
    </div>
</div>

