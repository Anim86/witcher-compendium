<div class="wizard-step step-skills">
    <h2>{{localize "WITCHER.Wizard.Step.Skills.Title"}}</h2>
    <p>{{localize "WITCHER.Wizard.Step.Skills.Description"}}</p>

    <div class="skills-container tabs" data-group="skill-tabs">
        <nav class="sheet-tabs tabs" data-group="skill-tabs">
            <a class="item {{#if (eq activeSkillTab 'profession-skills')}}active{{/if}}" data-action="switchSkillTab" data-tab="profession-skills">
                {{localize "WITCHER.Wizard.Skills.Professional"}}
                <span class="badge {{#if (lt professionPointsRemaining 0)}}negative{{/if}}">{{professionPointsRemaining}}</span>
            </a>
            <a class="item {{#if (eq activeSkillTab 'pickup-skills')}}active{{/if}}" data-action="switchSkillTab" data-tab="pickup-skills">
                {{localize "WITCHER.Wizard.Skills.Pickup"}}
                <span class="badge {{#if (lt pickupPointsRemaining 0)}}negative{{/if}}">{{pickupPointsRemaining}}</span>
            </a>
        </nav>

        <section class="content">
            <!-- TAB: Abilità Professionali -->
            <div class="tab {{#if (eq activeSkillTab 'profession-skills')}}active{{/if}}" data-group="skill-tabs" data-tab="profession-skills">
                <div class="points-display">
                    <span class="points-label">{{localize "WITCHER.Wizard.Skills.ProfessionPool"}}: </span>
                    <span class="points-value {{#if (lt professionPointsRemaining 0)}}negative{{/if}}">
                        {{professionPointsRemaining}} / 44
                    </span>
                </div>
                <div class="skills-grid compact-skills">
                    {{#each professionSkills}}
                    <div class="skill-row {{#if isDifficult}}skill-difficult{{/if}} {{#if isNativeLanguage}}skill-native{{/if}}" data-skill="{{key}}">
                        <label class="skill-label">
                            <span class="skill-name-text">{{name}}</span>
                            {{#if attributeLabel}}<span class="skill-attr-badge">{{attributeLabel}}</span>{{/if}}
                            {{#if isDifficult}}<span class="cost-badge">(Difficile ×2)</span>{{/if}}
                            {{#if isNativeLanguage}}<span class="native-badge"><i class="fa-solid fa-crown"></i> Madrelingua</span>{{/if}}
                        </label>
                        <div class="skill-controls">
                            <button type="button" class="ctrl-btn minus" data-action="adjustSkill" data-skill="{{key}}" data-type="profession" data-delta="-1">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <input type="number"
                                   class="skill-input"
                                   data-action="adjustSkill"
                                   data-skill="{{key}}"
                                   data-type="profession"
                                   name="skills.{{key}}"
                                   value="{{value}}"
                                   min="{{#if isNativeLanguage}}8{{else}}1{{/if}}"
                                   max="{{#if isNativeLanguage}}10{{else}}6{{/if}}"
                                   readonly>
                            <button type="button" class="ctrl-btn plus" data-action="adjustSkill" data-skill="{{key}}" data-type="profession" data-delta="1">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    {{/each}}
                    {{#unless professionSkills.length}}
                    <div class="no-pickup-skills" style="grid-column: 1 / -1; margin-top: 10px;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>La professione selezionata non ha abilità configurate, oppure le abilità non sono state trovate nel compendio. Apri la scheda della Professione (es. Criminale) nel compendio e assicurati di aver selezionato le "Abilità di Professione".</span>
                    </div>
                    {{/unless}}
                </div>
            </div>

            <!-- TAB: Abilità Pick-up -->
            <div class="tab {{#if (eq activeSkillTab 'pickup-skills')}}active{{/if}}" data-group="skill-tabs" data-tab="pickup-skills">
                <div class="skills-pool-info">
                    <span class="pool-label">{{localize "WITCHER.Wizard.Skills.PickupPool"}}: </span>
                    <span class="pool-value {{#if (lt pickupPointsRemaining 0)}}negative{{/if}}">
                        <strong>{{pickupPointsRemaining}}</strong>
                    </span>
                    <span class="pool-hint">{{localize "WITCHER.Wizard.Skills.PickupHint"}}</span>
                </div>

                <div class="skills-picker">
                    <div class="controls-row">
                        <select name="new-pickup-skill" id="new-pickup-skill-select">
                            <option value="">-- {{localize "WITCHER.Wizard.Skills.Add"}} --</option>
                            {{#each availablePickupSkills}}
                            <option value="{{key}}">{{name}} {{#if attributeLabel}}[{{attributeLabel}}]{{/if}} {{#if (eq cost 2)}}(Difficile ×2){{/if}}</option>
                            {{/each}}
                        </select>
                        <button type="button" data-action="addPickupSkill" class="btn-add">
                            <i class="fa-solid fa-plus"></i> {{localize "WITCHER.Wizard.Skills.AddButton"}}
                        </button>
                    </div>
                </div>

                {{#unless pickupSkills.length}}
                <div class="no-pickup-skills">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Non hai ancora aggiunto nessuna abilità di pickup. Seleziona un'abilità dal menu a tendina sopra e premi "Aggiungi".</span>
                </div>
                {{/unless}}

                <div class="skills-grid compact-skills pickup-grid">
                    {{#each pickupSkills}}
                    <div class="skill-row {{#if isDifficult}}skill-difficult{{/if}} {{#if isNativeLanguage}}skill-native{{/if}}" data-skill="{{key}}">
                        <label class="skill-label">
                            <span class="skill-name-text">{{name}}</span>
                            {{#if attributeLabel}}<span class="skill-attr-badge">{{attributeLabel}}</span>{{/if}}
                            {{#if isDifficult}}<span class="cost-badge">(Difficile ×2)</span>{{/if}}
                            {{#if isNativeLanguage}}<span class="native-badge"><i class="fa-solid fa-crown"></i> Madrelingua</span>{{/if}}
                        </label>
                        <div class="skill-controls">
                            <button type="button" class="ctrl-btn minus" data-action="adjustSkill" data-skill="{{key}}" data-type="pickup" data-delta="-1">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <input type="number"
                                   class="skill-input"
                                   data-action="adjustSkill"
                                   data-skill="{{key}}"
                                   data-type="pickup"
                                   name="skills.{{key}}"
                                   value="{{value}}"
                                   min="{{#if isNativeLanguage}}8{{else}}0{{/if}}"
                                   max="{{#if isNativeLanguage}}10{{else}}6{{/if}}"
                                   readonly>
                            <button type="button" class="ctrl-btn plus" data-action="adjustSkill" data-skill="{{key}}" data-type="pickup" data-delta="1">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </section>
    </div>
</div>
