<div class="wizard-step step-stats">
    <div class="step-header">
        <h2>{{localize "WITCHER.Wizard.Step.Stats.Title"}}</h2>
        <p class="stats-desc-row">
            <span>{{localize "WITCHER.Wizard.Step.Stats.Description"}}</span>
            <button type="button" class="ctrl-btn roll-stats-btn" data-action="rollStats"
                title="Distribuisci i punti rimanenti in modo casuale">
                <i class="fa-solid fa-dice"></i> Casuale
            </button>
        </p>
    </div>

    <div class="stats-outer-container">
        <div class="stats-grid">
            <!-- Points Reservoir integrated into the grid -->
            <div class="stat-vial-row points-reservoir-row {{#if (lt pointsRemaining 0)}}overbudget{{/if}}">
                <div class="stat-identity">
                    <span class="stat-label">PUNTI</span>
                    <span class="stat-short">Rimasti</span>
                </div>

                <div class="stat-vial-container">
                    <div class="vial-frame">
                        <div class="vial-fill reservoir-fill" style="width: {{pointsRemainingPct}}%"></div>
                        <div class="vial-glow"></div>
                    </div>
                </div>

                <div class="stat-controls reservoir-value-display">
                    <span class="reservoir-val">{{pointsRemaining}}</span>
                </div>

                <div class="stat-info-tip">
                    <i class="fa-solid fa-circle-info"></i>
                    <span class="tooltip-text">Punti caratteristica rimanenti da distribuire per definire il tuo
                        potenziale fisico e mentale (Totale: 60).</span>
                </div>
            </div>
            {{#each stats}}
            <div class="stat-vial-row" data-stat="{{@key}}">
                <div class="stat-identity">
                    <span class="stat-label">{{localize labelShort}}</span>
                    <span class="stat-short">{{localize label}}</span>
                </div>

                <div class="stat-vial-container">
                    <div class="vial-frame">
                        <div class="vial-fill" style="width: {{multiply value 10}}%"></div>
                        <div class="vial-glow"></div>
                    </div>
                </div>

                <div class="stat-controls">
                    <button type="button" class="ctrl-btn minus" data-action="adjustStat" data-stat="{{@key}}"
                        data-delta="-1">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <input type="number" class="stat-input" data-action="adjustStat" data-stat="{{@key}}"
                        name="stats.{{@key}}" value="{{value}}" readonly>
                    <button type="button" class="ctrl-btn plus" data-action="adjustStat" data-stat="{{@key}}"
                        data-delta="1">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                <div class="stat-info-tip">
                    <i class="fa-solid fa-circle-info"></i>
                    <span class="tooltip-text">{{localize (concat 'WITCHER.Actor.Stat.Desc.' @key)}}</span>
                </div>
            </div>
            {{/each}}
        </div>

        <div class="derived-stats-preview">
            <h3>{{localize "WITCHER.Wizard.Stats.DerivedPreview"}}</h3>
            <div class="derived-pills">
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.HP"}}</span>
                    <span class="value">{{derived.hp}}</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Sta"}}</span>
                    <span class="value">{{derived.sta}}</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Rec"}}</span>
                    <span class="value">{{derived.rec}}</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Stun"}}</span>
                    <span class="value">{{derived.stun}}</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Run"}}</span>
                    <span class="value">{{derived.run}}m</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Leap"}}</span>
                    <span class="value">{{derived.leap}}m</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Enc"}}</span>
                    <span class="value">{{derived.enc}}</span>
                </div>
                <div class="derived-pill">
                    <span class="label">{{localize "WITCHER.Actor.DerStat.Vigor"}}</span>
                    <span class="value">{{derived.vigor}}</span>
                </div>
                <div class="derived-pill" title="Danno Bonus in Mischia">
                    <span class="label">Mischia</span>
                    <span class="value">{{derived.meleeBonus}}</span>
                </div>
                <div class="derived-pill" title="Attacco Disarmato">
                    <span class="label">Pugno/Calcio</span>
                    <span class="value">{{derived.punch}}/{{derived.kick}}</span>
                </div>
            </div>
        </div>
    </div>
</div>