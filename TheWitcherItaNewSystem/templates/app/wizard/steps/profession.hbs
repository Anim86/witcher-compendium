<div class="wizard-step step-profession">
    <h2>{{localize "WITCHER.Wizard.Step.Profession.Title"}}</h2>

    <div class="wizard-split-layout">
        <!-- Master Panel: List of Professions -->
        <div class="master-panel profession-list">
            {{#each professions}}
            <div class="compact-selector-card {{#if (eq ../character.profession._id id)}}selected{{/if}}" data-action="selectProfession" data-prof-id="{{id}}">
                <img src="{{img}}" alt="{{name}}">
                <div class="selector-info">
                    <h3>{{name}}</h3>
                </div>
            </div>
            {{/each}}
        </div>

        <!-- Detail Panel: Detailed information of the selected Profession -->
        <div class="detail-panel">
            {{#if character.profession}}
                <div class="detail-header">
                    <img src="{{character.profession.img}}" alt="{{character.profession.name}}">
                    <div class="detail-title-wrapper">
                        <h2>{{character.profession.name}}</h2>
                        <span class="detail-subtitle">Professione del Continente</span>
                    </div>
                </div>
                <div class="detail-body">
                    <div class="detail-description">
                        {{#if character.profession.system.notes}}
                            {{{character.profession.system.notes}}}
                        {{else if character.profession.system.description}}
                            {{{character.profession.system.description}}}
                        {{else}}
                            <p>Seleziona una professione a sinistra per visualizzare la sua descrizione.</p>
                        {{/if}}
                    </div>
                    
                    {{#if character.profession.system.definingSkill.skillName}}
                    <div class="detail-perks-list">
                        <h3>Abilità Unica:</h3>
                        <details class="prof-skill-details unique-skill-details" open>
                            <summary class="prof-skill-tag unique-skill-tag">
                                <i class="fa-solid fa-star icon-left"></i>
                                {{character.profession.system.definingSkill.skillName}}
                                <i class="fa-solid fa-chevron-down toggle-icon"></i>
                            </summary>
                            <div class="prof-skill-desc unique-skill-desc">
                                {{{character.profession.system.definingSkill.definition}}}
                            </div>
                        </details>
                    </div>
                    {{/if}}

                    {{#if (or character.profession.system.skillPath1.pathName (or character.profession.system.skillPath2.pathName character.profession.system.skillPath3.pathName))}}
                    <div class="detail-perks-list">
                        <h3>Rami di Specializzazione:</h3>
                        <div class="prof-paths-container">
                            {{#if character.profession.system.skillPath1.pathName}}
                            <div class="prof-path-branch">
                                <h4>{{character.profession.system.skillPath1.pathName}}</h4>
                                <div class="prof-skills-expandable-list">
                                    {{#if character.profession.system.skillPath1.skill1.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath1.skill1.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath1.skill1.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath1.skill1.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                    {{#if character.profession.system.skillPath1.skill2.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath1.skill2.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath1.skill2.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath1.skill2.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                    {{#if character.profession.system.skillPath1.skill3.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath1.skill3.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath1.skill3.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath1.skill3.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                </div>
                            </div>
                            {{/if}}

                            {{#if character.profession.system.skillPath2.pathName}}
                            <div class="prof-path-branch">
                                <h4>{{character.profession.system.skillPath2.pathName}}</h4>
                                <div class="prof-skills-expandable-list">
                                    {{#if character.profession.system.skillPath2.skill1.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath2.skill1.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath2.skill1.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath2.skill1.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                    {{#if character.profession.system.skillPath2.skill2.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath2.skill2.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath2.skill2.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath2.skill2.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                    {{#if character.profession.system.skillPath2.skill3.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath2.skill3.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath2.skill3.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath2.skill3.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                </div>
                            </div>
                            {{/if}}

                            {{#if character.profession.system.skillPath3.pathName}}
                            <div class="prof-path-branch">
                                <h4>{{character.profession.system.skillPath3.pathName}}</h4>
                                <div class="prof-skills-expandable-list">
                                    {{#if character.profession.system.skillPath3.skill1.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath3.skill1.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath3.skill1.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath3.skill1.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                    {{#if character.profession.system.skillPath3.skill2.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath3.skill2.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath3.skill2.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath3.skill2.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                    {{#if character.profession.system.skillPath3.skill3.skillName}}
                                    <details class="prof-skill-details path-skill-details">
                                        <summary class="prof-skill-tag path-skill-tag">
                                            <span>
                                                <i class="fa-solid fa-turn-up icon-left rotate-90"></i>
                                                {{character.profession.system.skillPath3.skill3.skillName}}
                                                <span class="skill-stat-badge">({{character.profession.system.skillPath3.skill3.stat}})</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-down toggle-icon"></i>
                                        </summary>
                                        <div class="prof-skill-desc path-skill-desc">
                                            {{{character.profession.system.skillPath3.skill3.definition}}}
                                        </div>
                                    </details>
                                    {{/if}}
                                </div>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}


                </div>
            {{else}}
                <div class="detail-placeholder">
                    <i class="fa-solid fa-sword"></i>
                    <p>Seleziona una professione a sinistra per esaminare le sue caratteristiche e abilità.</p>
                </div>
            {{/if}}
        </div>
    </div>
</div>

