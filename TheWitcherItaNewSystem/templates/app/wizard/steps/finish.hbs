<div class="wizard-step step-finalize">
    <h2>{{localize "WITCHER.Wizard.Step.Finalize.Title"}}</h2>


    <div class="character-preview-grid">
        <div class="preview-sidebar">
            <div class="avatar-selection" data-action="selectAvatar">
                <img src="{{character.img}}" alt="{{character.name}}" class="wizard-avatar">
                <div class="avatar-overlay">
                    <i class="fa-solid fa-camera"></i>
                    <span>{{localize "WITCHER.Wizard.ChangeAvatar"}}</span>
                </div>
            </div>
            <div class="form-group character-name-selection">
                <label>{{localize "WITCHER.Actor.Name"}}</label>
                <input type="text" class="wizard-name-input" data-action="updateName" value="{{character.name}}">
            </div>
        </div>

        <div class="preview-main">
            <div class="summary-card">
                <h3>{{localize "WITCHER.Wizard.Summary.Details"}}</h3>
                <div class="summary-line">
                    <strong>{{localize "WITCHER.Wizard.Race"}}:</strong> {{character.race.name}}
                </div>
                <div class="summary-line">
                    <strong>{{localize "WITCHER.Wizard.Profession"}}:</strong> {{character.profession.name}}
                </div>
                <div class="summary-line">
                    <strong>{{localize "WITCHER.Wizard.BackgroundLabel"}}:</strong>
                    {{#if character.homeland}}{{character.homeland}}{{else}}Non selezionato{{/if}}{{#if character.background.socialStatus}} - {{character.background.socialStatus}}{{/if}}
                </div>
                {{#if character.background.familyState}}
                <div class="summary-line">
                    <strong>Famiglia:</strong>
                    {{#if (eq character.background.familyState "alive")}}Almeno parte della famiglia e viva{{else}}Qualcosa e accaduto alla famiglia{{/if}}
                </div>
                {{/if}}
                {{#if character.background.familyFate}}
                <div class="summary-line">
                    <strong>Sorte della Famiglia:</strong> {{character.background.familyFate}}
                </div>
                {{/if}}
                {{#if character.background.parentsState}}
                <div class="summary-line">
                    <strong>Genitori:</strong>
                    {{#if (eq character.background.parentsState "alive")}}Vivi{{else}}Qualcosa e accaduto ai genitori{{/if}}
                </div>
                {{/if}}
                {{#if character.background.parentsFate}}
                <div class="summary-line">
                    <strong>Sorte dei Genitori:</strong> {{character.background.parentsFate}}
                </div>
                {{/if}}
                {{#if character.background.events.length}}
                <div class="summary-line">
                    <strong>Eventi della Vita:</strong> {{character.background.events.length}}
                </div>
                {{/if}}
                <div class="summary-line">
                    <strong class="{{#if isOverBudget}}overbudget{{/if}}">💰 {{localize "WITCHER.Wizard.Gear.MoneyLabel"}}:</strong> {{character.money}} {{localize "WITCHER.Currency.crown"}}
                </div>
            </div>

            <div class="summary-card">
                <h3>{{localize "WITCHER.Wizard.Stats.Summary"}}</h3>
                <div class="stats-pills">
                    {{#each summary.stats}}
                    <div class="stat-pill">
                        <span class="stat-abbr">{{localize label}}</span>
                        <span class="stat-value">{{value}}</span>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="summary-card">
                <h3>Riepilogo Abilità</h3>
                <div class="stats-pills">
                    {{#each summary.skills}}
                    <div class="stat-pill">
                        <span class="stat-abbr">{{label}}</span>
                        <span class="stat-value">{{value}}</span>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="summary-card">
                <h3>{{localize "WITCHER.Wizard.Gear.InitialGear"}}</h3>
                <div class="profession-gear-list">
                    {{#each summary.professionGear}}
                    <span class="gear-tag">{{name}}</span>
                    {{else}}
                    <p><em>Nessun oggetto professionale scelto.</em></p>
                    {{/each}}
                </div>
            </div>

            <div class="summary-card">
                <h3>{{localize "WITCHER.Wizard.Gear.PurchasedGear"}}</h3>
                <div class="purchased-gear-list">
                    {{#each character.gear}}
                    <span class="gear-tag">{{name}}</span>
                    {{else}}
                    <p><em>Nessun oggetto acquistato.</em></p>
                    {{/each}}
                </div>
            </div>

            {{#if summary.selectedMagic.length}}
            <div class="summary-card">
                <h3>Magia Selezionata</h3>
                <div class="purchased-gear-list">
                    {{#each summary.selectedMagic}}
                    <span class="gear-tag" title="{{labelType}}">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> <strong>[{{labelType}}]</strong> {{name}}
                    </span>
                    {{/each}}
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <div class="finish-callout">
        <p>{{localize "WITCHER.Wizard.Finish.Callout"}}</p>
    </div>
</div>
