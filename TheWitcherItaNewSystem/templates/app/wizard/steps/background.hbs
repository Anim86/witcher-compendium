<div class="wizard-step step-background">
    <h2>{{localize "WITCHER.Wizard.Step.Background.Title"}}</h2>

    <div class="background-container">
        {{!-- Selezione Nome, Regione, Patria ed Età sempre visibili in alto --}}
        <div class="background-section origin-selection-header">
            <h3>Dettagli Personaggio & Origine</h3>
            <div class="origin-selectors-row">
                <div class="form-group">
                    <label>Nome Personaggio</label>
                    <div class="input-with-roll">
                        <input type="text" name="name" value="{{character.name}}" placeholder="Nome del personaggio..." data-action="updateName">
                        <button type="button" class="btn-roll-inline" data-action="rollName" title="Tira Nome casuale">
                            <i class="fa-solid fa-dice-d10"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>Regione d'Origine</label>
                    <select name="originRegion" data-action="updateOriginRegion">
                        <option value="">— Seleziona Regione —</option>
                        {{#each regions}}
                        <option value="{{this.value}}" {{#if (eq ../character.originRegion this.value)}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="form-group">
                    <label>{{localize "WITCHER.Wizard.Background.Homeland"}}</label>
                    <select name="homeland" data-action="updateHomeland" {{#unless character.originRegion}}disabled{{/unless}}>
                        <option value="">
                            {{#if character.originRegion}}
                                {{localize "WITCHER.Wizard.Background.SelectHomeland"}}
                            {{else}}
                                — Seleziona prima una regione —
                            {{/if}}
                        </option>
                        {{#each homelands}}
                        <option value="{{this.value}}" {{#if (eq ../character.homeland this.value)}}selected{{/if}}>{{localize this.label}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="form-group">
                    <label>{{localize "WITCHER.Wizard.Background.Age"}}</label>
                    <div class="input-with-roll">
                        <input type="number" 
                               name="age" 
                               value="{{character.age}}" 
                               min="{{ageLimits.min}}" 
                               max="{{ageLimits.max}}" 
                               data-action="updateAge">
                        <button type="button" class="btn-roll-inline" data-action="rollAge" title="Tira Età casuale">
                            <i class="fa-solid fa-dice-d10"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Sblocca il resto della generazione solo dopo aver scelto la Patria --}}
        {{#if character.homeland}}
            <div class="bg-grid-2col" style="margin-top: 15px;">
                {{!-- Colonna sinistra: Famiglia & Genitori --}}
                <div class="background-section">
                    <h3>Famiglia & Genitori</h3>

                    <div class="form-group">
                        <label>Stato della Famiglia</label>
                        <select name="background.familyState" data-action="updateBackground">
                            <option value="">— Seleziona Stato Famiglia —</option>
                            <option value="alive" {{#if (eq character.background.familyState "alive")}}selected{{/if}}>Almeno parte della famiglia è ancora viva.</option>
                            <option value="something_happened" {{#if (eq character.background.familyState "something_happened")}}selected{{/if}}>Qualcosa è Accaduto alla Famiglia</option>
                        </select>
                    </div>

                    {{#if (eq character.background.familyState "something_happened")}}
                    <div class="form-group nested-group">
                        <label>{{localize "WITCHER.Wizard.Background.FamilyFate"}}</label>
                        <div class="input-with-roll">
                            <textarea name="background.familyFate"
                                      placeholder="Tira il dado o scrivi manualmente…"
                                      data-action="updateBackground"
                                      rows="3">{{character.background.familyFate}}</textarea>
                            <button type="button" class="btn-roll-inline" data-action="rollFamilyFate" title="Tira Sorte della Famiglia">
                                <i class="fa-solid fa-dice-d10"></i>
                            </button>
                        </div>
                        {{#if familyFateOptions.length}}
                        <button type="button" class="btn-select-from-list" data-action="openListModal" data-field="background.familyFate" data-title="Seleziona Sorte della Famiglia">
                            <span>Scegli dalla lista...</span>
                            <i class="fa-solid fa-list"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/if}}

                    {{#if (eq character.background.familyState "alive")}}
                    <div class="form-group nested-group">
                        <label>Stato dei Genitori</label>
                        <select name="background.parentsState" data-action="updateBackground">
                            <option value="">— Seleziona Stato Genitori —</option>
                            <option value="alive" {{#if (eq character.background.parentsState "alive")}}selected{{/if}}>Genitori Vivi</option>
                            <option value="something_happened" {{#if (eq character.background.parentsState "something_happened")}}selected{{/if}}>Qualcosa è Accaduto ai Genitori</option>
                        </select>
                    </div>

                    {{#if (eq character.background.parentsState "something_happened")}}
                    <div class="form-group nested-group">
                        <label>Sorte dei Genitori</label>
                        <div class="input-with-roll">
                            <textarea name="background.parentsFate"
                                      placeholder="Tira il dado o scrivi manualmente…"
                                      data-action="updateBackground"
                                      rows="3">{{character.background.parentsFate}}</textarea>
                            <button type="button" class="btn-roll-inline" data-action="rollParentsFate" title="Tira Sorte dei Genitori">
                                <i class="fa-solid fa-dice-d10"></i>
                            </button>
                        </div>
                        {{#if parentsFateOptions.length}}
                        <button type="button" class="btn-select-from-list" data-action="openListModal" data-field="background.parentsFate" data-title="Seleziona Sorte dei Genitori">
                            <span>Scegli dalla lista...</span>
                            <i class="fa-solid fa-list"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/if}}

                    {{#if (eq character.background.parentsState "alive")}}
                    <div class="form-group nested-group">
                        <label>Situazione Familiare</label>
                        <div class="input-with-roll">
                            <textarea name="background.socialStatus" 
                                      placeholder="Tira il dado o scrivi manualmente…"
                                      data-action="updateBackground"
                                      rows="3">{{character.background.socialStatus}}</textarea>
                            <button type="button" class="btn-roll-inline" data-action="rollBackground" title="Tira Situazione Familiare">
                                <i class="fa-solid fa-dice-d10"></i>
                            </button>
                        </div>
                        {{#if socialStatusOptions.length}}
                        <button type="button" class="btn-select-from-list" data-action="openListModal" data-field="background.socialStatus" data-title="Seleziona Situazione Familiare">
                            <span>Scegli dalla lista...</span>
                            <i class="fa-solid fa-list"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{/if}}
                    {{/if}}
                </div>

                {{!-- Colonna destra: Eventi della Vita --}}
                <div class="background-section">
                    <h3>{{localize "WITCHER.Wizard.Background.LifeEvents"}}</h3>
                    <div class="events-list scrollable">
                        {{#each character.background.events}}
                        <div class="event-item">
                            <span class="event-age"><strong>{{age}} {{localize "WITCHER.Wizard.Background.Years"}}</strong></span>
                            <span class="event-text">{{{text}}}</span>
                        </div>
                        {{else}}
                        <p class="no-events">Ancora nessun evento registrato.</p>
                        {{/each}}
                    </div>
                    <button type="button" class="btn-roll-events" data-action="rollLifeEvents">
                        <i class="fa-solid fa-dice-d10"></i>
                        {{localize "WITCHER.Wizard.Background.RollNextEvent"}}
                    </button>
                </div>
            </div>
        {{else}}
            {{!-- Messaggio di blocco --}}
            <div class="origin-lock-message">
                <i class="fa-solid fa-scroll"></i>
                <p>Seleziona una <strong>Regione d'Origine</strong> e la tua <strong>Patria</strong> per sbloccare la generazione del tuo Background.</p>
            </div>
        {{/if}}
    </div>
</div>
