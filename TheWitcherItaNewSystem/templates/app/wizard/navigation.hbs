<nav class="wizard-navigation">
    {{#each steps}}
    <div class="nav-item {{#if active}}active{{/if}} {{#if complete}}completed{{/if}}" 
         data-action="goToStep" data-step="{{id}}">
        <div class="nav-icon-container">
            <i class="{{icon}}"></i>
        </div>
        <div class="nav-label-container">
            <span class="step-num">{{localize "WITCHER.Wizard.Navigation.Step"}} {{number}}</span>
            <span class="step-label">{{localize label}}</span>
        </div>
    </div>
    {{#unless @last}}<div class="nav-connector"></div>{{/unless}}
    {{/each}}
</nav>
