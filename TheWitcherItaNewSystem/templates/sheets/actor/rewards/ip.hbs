<div class="rewards-sheet-content">
    <div class="rewards-header">
        {{#if isGM}}
        <div class="gm-ip-actions">
            <button class="btn-premium add-ip-reward standard" data-action="giveReward" data-type="standard">
                <i class="fas fa-graduation-cap"></i> + Exp
            </button>
            <button class="btn-premium add-ip-reward magic" data-action="giveReward" data-type="magic">
                <i class="fas fa-sparkles"></i> + Magia
            </button>
        </div>
        {{else}}
        <div class="ip-info-hint">
            <i class="fas fa-info-circle"></i> {{localize "WITCHER.Rewards.SpendIpHint"}}
        </div>
        {{/if}}
    </div>

    <div class="current-ip-summary">
        <div class="ip-stat standard">
            <span class="label">Punti Exp Totali</span>
            <span class="value">{{system.improvementPoints}}</span>
        </div>
        <div class="ip-stat magic">
            <span class="label">Punti Magia Totali</span>
            <span class="value">{{system.magic.magicImprovementPoints}}</span>
        </div>
    </div>

    <div class="logs-header">
        <h4>{{localize "WITCHER.Rewards.LogTitle"}}</h4>
    </div>

    <div class="logs ip-logs">
        {{#each system.logs.ipLog}}
        <div class="log-item">
            <div class="log-info">
                <span class="reason">{{this.label}}</span>
                <span class="date">{{#if this.date}}{{date this.date 'DD MMM YYYY'}}{{/if}} {{#if this.isMagic}}<span class="magic-tag">MAGIA</span>{{/if}}</span>
            </div>
            <div class="log-controls">
                <div class="log-amount positive">
                    +{{this.ip}} PM
                </div>
                {{#if ../isGM}}
                <button class="btn-delete-log" data-action="deleteIpLog" data-index="{{@index}}" data-tooltip="{{localize 'WITCHER.Button.Delete'}}">
                    <i class="fas fa-trash"></i>
                </button>
                {{/if}}
            </div>
        </div>
        {{else}}
            <div class="empty-state">
                <i class="fas fa-history"></i>
                <p>{{localize "WITCHER.Rewards.NoLogs"}}</p>
            </div>
        {{/each}}
    </div>
</div>