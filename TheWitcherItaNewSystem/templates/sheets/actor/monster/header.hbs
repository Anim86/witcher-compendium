<div class="monster-sheet-header-v2 {{#unless isEditable}}readonly{{/unless}}" data-application-part="header">
    <div class="header-main-info">
        <div class="type-section {{system.monsterType}}">
            <img src="{{monsterIcon system.monsterType}}" class="type-icon" />
            <div class="type-meta">
                <span class="type-label">{{localize (lookup config.monsterTypes system.monsterType)}}</span>
            </div>
        </div>

        <div class="name-section">
            <input name="name" type="text" value="{{actor.name}}" class="monster-name-input" placeholder="{{localize 'WITCHER.Name'}}" {{#unless isEditable}}readonly{{/unless}} />
            <div class="badges-row">
                {{#if system.difficulty}}
                <div class="compact-badge difficulty-badge {{system.difficulty}}">
                    <i class="fas fa-skull"></i>
                    <span>{{localize (lookup config.monsterDifficulty system.difficulty)}}</span>
                </div>
                {{/if}}
                {{#if system.intelligence}}
                <div class="compact-badge" title="{{localize 'WITCHER.Stats.INT.Abbr'}}">
                    <i class="fas fa-brain"></i>
                    <span>{{system.intelligence}}</span>
                </div>
                {{/if}}
                {{#if system.senses}}
                <div class="compact-badge" title="{{localize 'WITCHER.Monster.Senses'}}">
                    <i class="fas fa-eye"></i>
                    <span>{{system.senses}}</span>
                </div>
                {{/if}}
                {{#if system.bounty}}
                <div class="compact-badge bounty" title="{{localize 'WITCHER.Monster.Bounty'}}">
                    <i class="fas fa-coins"></i>
                    <span>{{system.bounty}}</span>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="vitals-section">
            <div class="vital-item hp" title="{{localize 'WITCHER.Stats.HP.Abbr'}}">
                <i class="fas fa-heart"></i>
                <div class="vital-values">
                    <span class="value">{{system.derivedStats.hp.value}}</span>
                    <span class="sep">/</span>
                    <span class="max">{{system.derivedStats.hp.max}}</span>
                </div>
            </div>
            <div class="vital-item sta" title="{{localize 'WITCHER.Stats.STA.Abbr'}}">
                <i class="fas fa-bolt"></i>
                <div class="vital-values">
                    <span class="value">{{system.derivedStats.sta.value}}</span>
                    <span class="sep">/</span>
                    <span class="max">{{system.derivedStats.sta.max}}</span>
                </div>
            </div>
            <div class="vital-item armor" title="{{localize 'WITCHER.Stats.Armor.Abbr'}}">
                <i class="fas fa-shield-alt"></i>
                <span class="value">{{system.stats.armor.value}}</span>
            </div>
            <div class="vital-item toxicity" title="{{localize 'WITCHER.Actor.Stat.Toxicity'}}">
                <i class="fas fa-skull-crossbones"></i>
                <div class="vital-values">
                    <input name="system.stats.toxicity.value" type="text" data-dtype="Number" value="{{system.stats.toxicity.value}}" {{#unless isEditable}}readonly{{/unless}} />
                    <span class="sep">/</span>
                    <span class="max">{{system.stats.toxicity.max}}</span>
                </div>
            </div>
        </div>
    </div>
</div>
