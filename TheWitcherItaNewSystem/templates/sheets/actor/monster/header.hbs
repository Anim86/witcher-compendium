<div class="monster-header" data-application-part="header">
    <div class="header-left">
        {{#if system.monsterType}}
        <div class="monster-type-mini">
            <img class="mini-type-icon" src="systems/TheWitcherItaNewSystem/assets/images/Monsters/{{system.monsterType}}.png" data-tooltip="{{localize (lookup config.MonsterTypes system.monsterType)}}" />
            <div class="mini-type-details">
                <span class="type-name">{{localize (lookup config.MonsterTypes system.monsterType)}}</span>
                <span class="size-tag">{{localize "WITCHER.table.Size"}}: {{#if system.size}}{{system.size}}{{else}}?{{/if}}</span>
            </div>
        </div>
        {{/if}}

        <div class="header-name-box">
            <h1><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'WITCHER.Name'}}" /></h1>
            <div class="monster-badges">
                <span class="badge difficulty {{system.difficulty}}">{{localize (lookup config.monsterDifficulty system.difficulty)}}</span>
                <span class="badge intelligence">
                    <i class="fas fa-brain"></i>
                    <input name="system.intelligence" type="text" value="{{system.intelligence}}" placeholder="?" />
                </span>
                <span class="badge senses">
                    <i class="fas fa-eye"></i>
                    <input name="system.senses" type="text" value="{{system.senses}}" placeholder="?" />
                </span>
            </div>
        </div>
    </div>

    <div class="header-right">
        <div class="monster-bounty-badge">
            <i class="fas fa-coins"></i>
            <div class="bounty-content">
                <span class="bounty-label">{{localize "WITCHER.Monster.Bounty"}}</span>
                <input name="system.bounty" type="number" value="{{system.bounty}}" />
            </div>
        </div>
    </div>
</div>
