<aside class="monster-sidebar {{#unless isEditable}}readonly{{/unless}}" data-application-part="sidebar">
    <div class="artwork-container">
        <img class="monster-artwork" src="{{actorImg}}" data-edit="img" title="{{actor.name}}" />
        
        <div class="vitals-overlay">
            <div class="vital-orb hp" data-tooltip="{{localize 'WITCHER.Stats.HP.Abbr'}}">
                <i class="fas fa-heart"></i>
                <input name="system.derivedStats.hp.value" type="text" value="{{system.derivedStats.hp.value}}" {{#unless isEditable}}readonly{{/unless}} />
            </div>
            <div class="vital-orb sta" data-tooltip="{{localize 'WITCHER.Stats.STA.Abbr'}}">
                <i class="fas fa-bolt"></i>
                <input name="system.derivedStats.sta.value" type="text" value="{{system.derivedStats.sta.value}}" {{#unless isEditable}}readonly{{/unless}} />
            </div>
             <div class="vital-orb resolve" data-tooltip="{{localize 'WITCHER.Stats.Resolve.Abbr'}}">
                <i class="fas fa-brain"></i>
                <input name="system.derivedStats.resolve.value" type="text" value="{{system.derivedStats.resolve.value}}" {{#unless isEditable}}readonly{{/unless}} />
            </div>
        </div>
    </div>

    {{!-- Quick Actions --}}
    <div class="monster-quick-actions">
        <a class="action-btn roll-init" data-action="rollInit" title="{{localize 'WITCHER.Button.RollInit'}}">
            <i class="fas fa-running"></i>
            <span>{{localize "WITCHER.Stats.SPD.Abbr"}}</span>
        </a>
    </div>

    {{!-- Primary Stats Grid --}}
    <div class="sidebar-stats-grid">
        {{#each system.stats as |stat id|}}
        {{#unless (eq id "armor")}}
        <div class="sidebar-stat-box" data-stat="{{id}}">
            <a class="stat-roll-btn" data-action="rollStat" data-stat="{{id}}" title="{{localize 'WITCHER.Button.Roll'}}">
                <span class="stat-abbr">{{localize (lookup (lookup ../config.statMap id) 'label')}}</span>
            </a>
            <input type="text" name="system.stats.{{id}}.value" value="{{stat.value}}" data-dtype="Number" {{#unless ../isEditable}}readonly{{/unless}} />
        </div>
        {{/unless}}
        {{/each}}
    </div>
</aside>
