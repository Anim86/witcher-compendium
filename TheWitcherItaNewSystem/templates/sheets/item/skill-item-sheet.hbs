<section class="scrollable">
    {{>"systems/TheWitcherItaNewSystem/templates/partials/item-header.hbs"}}

    <div class="properties-grid main-stats">
        <div class="property-card">
            <label>{{localize "WITCHER.Actor.StatTitle.Attributes"}}</label>
            <select name="system.attribute">
                {{selectOptions stats selected=item.system.attribute localize=true}}
            </select>
        </div>
    </div>

    <div class="item-description-container">
        <div class="section-title">
            <i class="fas fa-scroll"></i> {{localize "WITCHER.Item.Description"}}
        </div>
        {{editor item.system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>
</section>