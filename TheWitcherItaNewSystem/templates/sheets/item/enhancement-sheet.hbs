<section class="scrollable">
    {{>"systems/TheWitcherItaNewSystem/templates/partials/item-header.hbs"}}
    
    <div class="properties-grid main-stats">
        <div class="property-card highlight">
            <label>{{localize "WITCHER.Type"}}</label>
            <select name="system.type" id="type-select">
                {{selectOptions selects.enhancementTypes selected=item.system.type localize=true}}
            </select>
        </div>
        {{#if (eq item.system.type "armor")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Item.Short.Availability"}}</label>
            <select name="system.avail" id="avail-select">
                {{selectOptions config.Availability selected=item.system.avail localize=true}}
            </select>
        </div>
        <div class="property-card highlight">
            <label>{{localize "WITCHER.Enhancement.Stopping"}}</label>
            <input type="text" name="system.stopping" value="{{item.system.stopping}}" data-dtype="Number" />
        </div>
        {{/if}}
    </div>

    {{#if (eq item.system.type "armor")}}
    <div class="item-description-container">
        <div class="section-title">
            <i class="fas fa-shield-alt"></i> {{localize "WITCHER.Armor.Resistances"}}
        </div>
        <div class="checkbox-chip-group">
            <label class="checkbox-chip {{#if item.system.bludgeoning}}active{{/if}}">
                <input type="checkbox" name="system.bludgeoning" {{checked item.system.bludgeoning}} />
                <span>{{localize "WITCHER.Enhancement.Bludgeoning"}}</span>
            </label>
            <label class="checkbox-chip {{#if item.system.slashing}}active{{/if}}">
                <input type="checkbox" name="system.slashing" {{checked item.system.slashing}} />
                <span>{{localize "WITCHER.Enhancement.Slashing"}}</span>
            </label>
            <label class="checkbox-chip {{#if item.system.piercing}}active{{/if}}">
                <input type="checkbox" name="system.piercing" {{checked item.system.piercing}} />
                <span>{{localize "WITCHER.Enhancement.Piercing"}}</span>
            </label>
        </div>
    </div>
    {{/if}}

    <div class="effects-section">
        <div class="section-title">
            <i class="fas fa-magic"></i> {{localize "WITCHER.Item.Effect"}}
            <a class="add-effect" data-action="addEffect"><i class="fas fa-plus-circle"></i></a>
        </div>
        
        <div class="effects-list">
            {{#each item.system.effects as |effect name|}}
                <div class="effect-row list-item" data-id="{{effect.id}}">
                    <textarea class="item-effect" data-action="editEffect" data-field="name" placeholder="{{localize 'WITCHER.table.Description'}}" rows="1">{{effect.name}}</textarea>
                    
                    <select class="item-effect" data-action="editEffect" data-field="statusEffect">
                        {{#if (or (eq ../item.system.type "weapon") (eq ../item.system.type "rune"))}}
                            {{selectOptions ../config.statusEffects blank='' selected=effect.statusEffect nameAttr='id' valueAttr="id" labelAttr="name" localize=true}}
                        {{else}}
                            {{selectOptions ../config.armorEffects blank='' selected=effect.statusEffect nameAttr='id' valueAttr="id" labelAttr="name" localize=true}}
                        {{/if}}
                    </select>

                    <div class="effect-percentage">
                        <input data-action="editEffect" data-field="percentage" type="text" value="{{effect.percentage}}" data-dtype="Number" />
                        <span>%</span>
                    </div>

                    <a class="remove-effect" data-action="removeEffect"><i class="fas fa-times"></i></a>
                </div>
            {{/each}}
        </div>
    </div>
</section>

