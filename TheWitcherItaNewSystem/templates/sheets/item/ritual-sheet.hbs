<section class="scrollable">
    <header class="item-header">
        <h1 class="itemname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'WITCHER.Name'}}" /></h1>
        <a class="configure-item" data-action="configureItem"><i class="fas fa-gear"></i></a>
        <general>
            <itemimage>
                {{#if (and (includes (getSetting "clickableImageItemTypes") item.type)  (or (window "game" "user" "isGM") (eq (getSetting "clickableImageCheckboxForGMOnly") false)) )}}
                    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
                    <div>
                        <input type="checkbox" id="clickable-image-{{item._id}}" name="system.clickableImage"
                            {{checked item.system.clickableImage}}>
                        <label for="clickable-image-{{item._id}}">{{localize "WITCHER.Item.ClickableImage"}}</label>
                    </div>
                {{else}}
                    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
                {{/if}}
            </itemimage>
            
            <div class="information-grid">
                <div class="info-item">
                    <label>{{localize "WITCHER.Spell.type"}}</label>
                    <span>{{localize "WITCHER.Spell.Ritual.name"}}</span>
                </div>
                <div class="info-item">
                    <label>{{localize "WITCHER.Actor.Profession.Level"}}</label>
                    <select name="system.level">
                        {{selectOptions selects.levelSpell selected=item.system.level localize=true}}
                    </select>
                </div>
                <div class="info-item">
                    <label>{{localize "WITCHER.Item.Cost"}}</label>
                    <input type="text" name="system.cost" value="{{item.system.cost}}" data-dtype="Number" />
                </div>
                <div class="info-item">
                    <label>{{localize "WITCHER.Item.SourceBook"}}</label>
                    <input type="text" name="system.sourcebook" value="{{item.system.sourcebook}}" />
                </div>
            </div>
        </general>
    </header>

    <div class="item-description-container">
        <div class="section-title">
            <i class="fas fa-scroll"></i> {{localize "WITCHER.Item.Effect"}}
        </div>
        {{editor item.system.effect target="system.effect" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>

    {{#unless item.system.ritualComponents}}
        <div class="item-description-container">
            <div class="section-title">
                <i class="fas fa-boxes-stacked"></i> {{localize "WITCHER.Spell.Ritual.components"}}
            </div>
            {{editor item.system.components target="system.components" button=true owner=owner editable=editable engine="prosemirror"}}
        </div>
    {{/unless}}

    <div class="properties-grid main-stats">
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Short.Variable"}}</label>
            <input type="checkbox" name="system.staminaIsVar" {{checked item.system.staminaIsVar}} />
        </div>
        {{#unless item.system.staminaIsVar}}
        <div class="property-card highlight">
            <label>{{localize "WITCHER.Spell.Short.StaCost"}}</label>
            <input name="system.stamina" type="text" value="{{item.system.stamina}}" />
        </div>
        {{/unless}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.PrepTime"}}</label>
            <input name="system.preparationTime" type="text" value="{{item.system.preparationTime}}" />
        </div>
         <div class="property-card highlight">
            <label>{{localize "WITCHER.Spell.DC"}}</label>
            <input name="system.difficultyCheck" type="text" value="{{item.system.difficultyCheck}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Duration"}}</label>
            <input name="system.duration" type="text" value="{{item.system.duration}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Range"}}</label>
            <input name="system.range" type="text" value="{{item.system.range}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Defence"}}</label>
            <input name="system.defence" type="text" value="{{item.system.defence}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetMode.Label"}}</label>
            <select name="system.targetMode">
                {{selectOptions selects.targetMode selected=item.system.targetMode blank="" localize=true}}
            </select>
        </div>
        {{#if (eq item.system.targetMode "targetStat")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetStat"}}</label>
            <select name="system.targetStat">
                {{selectOptions selects.targetStat selected=item.system.targetStat blank="" localize=true}}
            </select>
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetMultiplier"}}</label>
            <input name="system.targetMultiplier" type="number" value="{{item.system.targetMultiplier}}" />
        </div>
        {{/if}}
        {{#if (eq item.system.targetMode "fixedDc")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetDc"}}</label>
            <input name="system.targetDc" type="number" value="{{item.system.targetDc}}" />
        </div>
        {{/if}}
        {{#if (or (eq item.system.targetMode "area") item.system.areaShape item.system.areaSize)}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.AreaShape"}}</label>
            <select name="system.areaShape">
                {{selectOptions selects.areaShape selected=item.system.areaShape blank="" localize=true}}
            </select>
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.AreaSize"}}</label>
            <input name="system.areaSize" type="text" value="{{item.system.areaSize}}" />
        </div>
        {{/if}}
    </div>

    <div class="item-settings-grid">
         <div class="settings-column full-width">
            <div class="section-title">
                <i class="fas fa-bullseye"></i> {{localize "WITCHER.Spell.CreateTemplate"}}
                <div class="float-right">
                    <input type="checkbox" name="system.createTemplate" {{checked item.system.createTemplate}} />
                </div>
            </div>
            {{#if item.system.createTemplate}}
            <div class="properties-grid" style="grid-template-columns: repeat(3, 1fr); margin-top: 10px;">
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.Size"}} (m)</label>
                    <input type="text" name="system.templateSize" value="{{item.system.templateSize}}" />
                </div>
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.Type"}}</label>
                    <select name="system.templateType">
                        {{selectOptions selects.templateType selected=item.system.templateType localize=true}}
                    </select>
                </div>
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.VisualEffectDuration"}}</label>
                    <input name="system.visualEffectDuration" type="number" value="{{item.system.visualEffectDuration}}" />
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <div class="components-list-container">
        <div class="section-title">
            <i class="fas fa-mortar-pestle"></i> {{localize "WITCHER.Spell.Ritual.components"}}
        </div>
        <div class="components-grid">
            {{#each item.system.ritualComponents as |component name|}}
                <div class="component-row list-item" data-uuid="{{component.item.uuid}}" data-target="ritualComponentUuids">
                    <img class="component-img" src="{{component.item.img}}" />
                    <div class="component-name">{{component.item.name}}</div>
                    <div class="component-quantity">
                        <label>{{localize "WITCHER.Inventory.Quantity"}}</label>
                        <input class="edit-component" data-field="quantity" type="number" value="{{component.quantity}}" />
                    </div>
                    <a class="control-icon remove-component"><i class="fas fa-trash"></i></a>
                </div>
            {{/each}}
        </div>
    </div>

    <div class="components-list-container">
        <div class="section-title">
            <i class="fas fa-exchange-alt"></i> {{localize "WITCHER.Spell.Ritual.alternateComponents"}}
        </div>
        <div class="components-grid">
            {{#each item.system.alternateRitualComponents as |component name|}}
                <div class="component-row list-item" data-uuid="{{component.item.uuid}}" data-target="alternateRitualComponentUuids">
                    <img class="component-img" src="{{component.item.img}}" />
                    <div class="component-name">{{component.item.name}}</div>
                    <div class="component-quantity">
                        <label>{{localize "WITCHER.Inventory.Quantity"}}</label>
                        <input class="edit-component" data-field="quantity" type="number" value="{{component.quantity}}" />
                    </div>
                    <a class="control-icon remove-component"><i class="fas fa-trash"></i></a>
                </div>
            {{/each}}
        </div>
    </div>
</section>
