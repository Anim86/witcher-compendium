<section class="scrollable">
    {{>"systems/TheWitcherItaNewSystem/templates/partials/spell-header.hbs"}}

    {{#if (eq item.system.class "MagicalGift")}}
    <div class="item-description-container">
        <div class="section-title">
            <i class="fas fa-exclamation-triangle"></i> {{localize "WITCHER.Spell.SideEffect"}}
        </div>
        {{editor item.system.sideEffect target="system.sideEffect" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>
    {{/if}}

    <div class="properties-grid main-stats" style="grid-template-columns: none; grid-template-rows: 1fr; grid-auto-flow: column; grid-auto-columns: minmax(92px, 1fr); overflow-x: auto;">
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Short.Variable"}}</label>
            <input type="checkbox" name="system.staminaIsVar" {{checked item.system.staminaIsVar}} />
        </div>
        {{#unless item.system.staminaIsVar}}
        <div class="property-card highlight">
            <label>{{localize "WITCHER.Spell.Short.StaCost"}}</label>
            <input name="system.stamina" type="text" value="{{item.system.stamina}}" />
        </div>
        {{/unless}}
        {{#unless (eq item.system.class "MagicalGift")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Range"}}</label>
            <input name="system.range" type="text" value="{{item.system.range}}" />
        </div>
        {{/unless}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Duration"}}</label>
            <input name="system.duration" type="text" value="{{item.system.duration}}" />
        </div>
        {{#unless (eq item.system.class "MagicalGift")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Defence"}}</label>
            <input name="system.defence" type="text" value="{{item.system.defence}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetMode.Label"}}</label>
            <select name="system.targetMode">
                {{selectOptions selects.targetMode selected=item.system.targetMode blank="" localize=true}}
            </select>
        </div>
        {{#if (eq item.system.targetMode "targetStat")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetStat"}}</label>
            <select name="system.targetStat">
                {{selectOptions selects.targetStat selected=item.system.targetStat blank="" localize=true}}
            </select>
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetMultiplier"}}</label>
            <input name="system.targetMultiplier" type="number" value="{{item.system.targetMultiplier}}" />
        </div>
        {{/if}}
        {{#if (eq item.system.targetMode "fixedDc")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.TargetDc"}}</label>
            <input name="system.targetDc" type="number" value="{{item.system.targetDc}}" />
        </div>
        {{/if}}
        {{#if (or (eq item.system.targetMode "area") item.system.areaShape item.system.areaSize)}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.AreaShape"}}</label>
            <select name="system.areaShape">
                {{selectOptions selects.areaShape selected=item.system.areaShape blank="" localize=true}}
            </select>
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.AreaSize"}}</label>
            <input name="system.areaSize" type="text" value="{{item.system.areaSize}}" />
        </div>
        {{/if}}
        {{/unless}}
        {{#if (eq item.system.class "Witcher")}}
        <div class="property-card">
            <label>{{localize "WITCHER.Spell.Sign"}} {{localize "WITCHER.Spell.Type"}}</label>
            <select name="system.domain">
                {{selectOptions selects.domain selected=item.system.domain localize=true}}
            </select>
        </div>
        {{/if}}
    </div>

    <div class="item-settings-grid">
        <div class="settings-column">
            <div class="section-title"><i class="fas fa-bullseye"></i> {{localize "WITCHER.Spell.CreateTemplate"}}</div>
            <div class="checkbox-group">
                 <label class="checkbox-row">
                    <input type="checkbox" name="system.createTemplate" {{checked item.system.createTemplate}} />
                    <span>{{localize "WITCHER.Spell.CreateTemplate"}}</span>
                </label>
                {{#if item.system.createTemplate}}
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.Size"}} (m)</label>
                    <input type="text" name="system.templateSize" value="{{item.system.templateSize}}" />
                </div>
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.Type"}}</label>
                    <select name="system.templateType">
                        {{selectOptions selects.templateType selected=item.system.templateType localize=true}}
                    </select>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="settings-column">
            <div class="section-title"><i class="fas fa-fire"></i> {{localize "WITCHER.Item.Settings.settings"}}</div>
            <div class="checkbox-group">
                <label class="checkbox-row">
                    <input type="checkbox" name="system.causeDamages" {{checked item.system.causeDamages}} />
                    <span>{{localize "WITCHER.Spell.Damage"}}</span>
                </label>
                 {{#if item.system.causeDamages}}
                <div class="property-row">
                    <label>{{localize "WITCHER.Weapon.Short.Damage"}}</label>
                    <input name="system.damage" type="text" value="{{#unless item.system.damage}}1d6+0{{else}}{{item.system.damage}}{{/unless}}" />
                </div>
                <div class="property-row">
                    <label>{{localize "WITCHER.Dialog.damageType"}}</label>
                    <select name="system.damageType">
                        {{selectOptions config.damageTypes selected=item.system.damageType localize=true}}
                    </select>
                </div>
                {{/if}}
                <label class="checkbox-row">
                    <input type="checkbox" name="system.createsShield" {{checked item.system.createsShield}} />
                    <span>{{localize "WITCHER.Spell.createsShield"}}</span>
                </label>
                {{#if item.system.createsShield}}
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.Short.Shield"}}</label>
                    <input name="system.shield" type="text" value="{{#unless item.system.shield}}1d6+0{{else}}{{item.system.shield}}{{/unless}}" />
                </div>
                {{/if}}
                <label class="checkbox-row">
                    <input type="checkbox" name="system.doesHeal" {{checked item.system.doesHeal}} />
                    <span>{{localize "WITCHER.Spell.doesHeal"}}</span>
                </label>
                {{#if item.system.doesHeal}}
                <div class="property-row">
                    <label>{{localize "WITCHER.Spell.Short.Heal"}}</label>
                    <input name="system.heal" type="text" value="{{#unless item.system.heal}}1d6+0{{else}}{{item.system.heal}}{{/unless}}" />
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</section>

