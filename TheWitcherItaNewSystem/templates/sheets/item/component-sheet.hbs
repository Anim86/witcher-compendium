<section class="{{item.type}} scrollable">
    {{>"systems/TheWitcherItaNewSystem/templates/partials/item-header.hbs"}}

    <div class="item-description-container">
        <div class="section-title">
            <i class="fas fa-scroll"></i> {{localize "WITCHER.Item.Description"}}
        </div>
        {{editor item.system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>

    <div class="item-settings-grid">
        <div class="settings-column">
            <div class="section-title"><i class="fas fa-boxes"></i> {{localize "WITCHER.Type"}}</div>
            <div class="property-row">
                <select name="system.type" id="type-select">
                    {{#select item.system.type}}
                        <option value="crafting-material">{{localize "WITCHER.Item.CraftingMaterial"}}</option>
                        <option value="animal-parts">{{localize "WITCHER.Item.Hides&AnimalParts"}}</option>
                        <option value="alchemical">{{localize "WITCHER.Item.AlchemicalTreatments"}}</option>
                        <option value="minerals">{{localize "WITCHER.Item.Ingots&Minerals"}}</option>
                        <option value="substances">{{localize "WITCHER.Inventory.Substances"}}</option>
                    {{/select}}
                </select>
            </div>
            {{#if (eq item.system.type "substances")}}
                <div class="property-row">
                    <label>{{localize "WITCHER.Inventory.Substance"}}:</label>
                    <select name="system.substanceType" id="substanceType-select">
                        {{#select item.system.substanceType}}
                            {{#each config.substanceTypes as |name type|}}
                                <option value="{{type}}">{{localize name}}</option>
                            {{/each}}
                        {{/select}}
                    </select>
                </div>
            {{/if}}
        </div>

        <div class="settings-column">
             <div class="section-title"><i class="fas fa-info-circle"></i> {{localize "WITCHER.Item.Settings.general"}}</div>
             <div class="property-row">
                <label>{{localize "WITCHER.Component.Rarity"}}</label>
                <select name="system.rarity">
                    {{#select item.system.rarity}}
                        {{#each config.Availability as |name value|}}
                            <option value="{{value}}">{{localize name}}</option>
                        {{/each}}
                    {{/select}}
                </select>
            </div>
        </div>
    </div>

    <div class="properties-grid main-stats">
        <div class="property-card">
            <label>{{localize "WITCHER.Component.Location"}}</label>
            <input type="text" name="system.location" value="{{item.system.location}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Component.Quantity"}}</label>
            <input type="text" name="system.quantityObtainable" value="{{item.system.quantityObtainable}}" />
        </div>
        <div class="property-card highlight">
            <label>{{localize "WITCHER.Component.Forage"}}</label>
            <input type="text" name="system.forage" value="{{item.system.forage}}" />
        </div>
    </div>
</section>


