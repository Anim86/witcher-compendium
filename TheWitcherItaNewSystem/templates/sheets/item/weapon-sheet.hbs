<section class="scrollable">
    {{>"systems/TheWitcherItaNewSystem/templates/partials/item-header.hbs"}}

    <div class="item-description-container">
        <div class="section-title">
            <i class="fas fa-scroll"></i> {{localize "WITCHER.Item.Description"}}
        </div>
        {{editor item.system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>

    {{#if (or item.system.notes editable)}}
    <div class="item-notes-container">
        <div class="section-title">
            <i class="fas fa-sticky-note"></i> {{localize "WITCHER.Notes"}}
        </div>
        {{editor item.system.notes target="system.notes" button=true owner=owner editable=editable engine="prosemirror"}}
    </div>
    {{/if}}

    {{#unless item.system.isAmmo}}
    <div class="properties-grid main-stats">
        <div class="property-card highlight">
            <label>{{localize "WITCHER.Weapon.Damage"}}</label>
            <input type="text" name="system.damage" placeholder="1d6+0" value="{{item.system.damage}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Range"}}</label>
            <input type="text" name="system.range" placeholder="0m" value="{{item.system.range}}" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Short.WeaponAccuracy"}}</label>
            <input type="number" name="system.accuracy" value="{{item.system.accuracy}}" data-dtype="Number" />
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Short.RateOfFire"}}</label>
            <input type="number" name="system.rateOfFire" value="{{item.system.rateOfFire}}" data-dtype="Number" />
        </div>
    </div>
    {{/unless}}

    <div class="properties-grid secondary-stats">
        <div class="property-card reliability-group">
            <label>{{localize "WITCHER.Weapon.Short.Reliability"}}</label>
            <div class="dual-input">
                <input type="number" name="system.reliability" value="{{item.system.reliability}}" data-dtype="Number" title="{{localize 'WITCHER.Weapon.Reliability'}}"/>
                <span class="separator">/</span>
                <input type="number" name="system.reliabilityMax" value="{{item.system.reliabilityMax}}" data-dtype="Number" title="{{localize 'WITCHER.Weapon.MaxReliability'}}"/>
            </div>
        </div>
        {{#unless item.system.isAmmo}}
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Hands.title"}}</label>
            <select name="system.hands">
                {{selectOptions config.weapon.hands selected=item.system.hands localize=true}}
            </select>
        </div>
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Category.title"}}</label>
            <select name="system.category">
                {{selectOptions config.weapon.categories selected=item.system.category localize=true}}
            </select>
        </div>
        {{/unless}}
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Short.Concealment"}}</label>
            <select name="system.conceal">
                {{selectOptions config.Concealment blank='' selected=item.system.conceal localize=true}}
            </select>
        </div>
        {{#unless item.system.isAmmo}}
        <div class="property-card">
            <label>{{localize "WITCHER.Weapon.Short.Enhancements"}}</label>
            <input type="number" name="system.enhancements" value="{{item.system.enhancements}}" data-dtype="Number" />
        </div>
        {{/unless}}
    </div>

    <div class="item-settings-grid">
        <div class="settings-column">
            <div class="section-title"><i class="fas fa-tags"></i> {{localize "WITCHER.Dialog.damageType"}}</div>
            <div class="damage-types-container">
                <label class="checkbox-chip {{#if item.system.type.slashing}}active{{/if}}">
                    <input type="checkbox" name="system.type.slashing" {{checked item.system.type.slashing}} />
                    <span>{{localize "WITCHER.Enhancement.Slashing"}}</span>
                </label>
                <label class="checkbox-chip {{#if item.system.type.piercing}}active{{/if}}">
                    <input type="checkbox" name="system.type.piercing" {{checked item.system.type.piercing}} />
                    <span>{{localize "WITCHER.Enhancement.Piercing"}}</span>
                </label>
                <label class="checkbox-chip {{#if item.system.type.bludgeoning}}active{{/if}}">
                    <input type="checkbox" name="system.type.bludgeoning" {{checked item.system.type.bludgeoning}} />
                    <span>{{localize "WITCHER.Enhancement.Bludgeoning"}}</span>
                </label>
                <label class="checkbox-chip {{#if item.system.type.elemental}}active{{/if}}">
                    <input type="checkbox" name="system.type.elemental" {{checked item.system.type.elemental}} />
                    <span>{{localize "WITCHER.Enhancement.Elemental"}}</span>
                </label>
            </div>
        </div>

        <div class="settings-column">
            <div class="section-title"><i class="fas fa-cog"></i> {{localize "WITCHER.Item.Settings.settings"}}</div>
            <div class="checkbox-group">
                <label class="checkbox-row">
                    <input type="checkbox" name="system.rollOnlyDmg" {{checked item.system.rollOnlyDmg}} />
                    <span>{{localize "WITCHER.Weapon.onlyDmg"}}</span>
                </label>
                <label class="checkbox-row">
                    <input type="checkbox" name="system.usingAmmo" {{checked item.system.usingAmmo}} />
                    <span>{{localize "WITCHER.Weapon.useAmmo"}}</span>
                </label>
                <label class="checkbox-row">
                    <input type="checkbox" name="system.isAmmo" {{checked item.system.isAmmo}} />
                    <span>{{localize "WITCHER.Weapon.isAmmunition"}}</span>
                </label>
                <div class="property-row">
                    <label>{{localize "WITCHER.Item.Short.Availability"}}</label>
                    <select name="system.avail">
                        {{selectOptions config.Availability blank='' selected=item.system.avail localize=true}}
                    </select>
                </div>
            </div>
        </div>
    </div>

    {{>"systems/TheWitcherItaNewSystem/templates/partials/associated-diagram.hbs"}}
</section>

