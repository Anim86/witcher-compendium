<div class="weapon_roll_sheet">
    {{!-- Premium Header Banner --}}
    <div class="item-header-info premium-banner">
        <div class="banner-border-line-top"></div>
        <img class="item-img" src="{{item.img}}" title="{{item.name}}" />
        <div class="item-info-text">
            <h3 class="item-name">{{item.name}}</h3>
            <div class="item-meta-badges">
                <span class="meta-badge dmg-badge">
                    <i class="fas fa-dice-d20"></i>
                    {{localize "WITCHER.Dialog.attackDamage"}}: <strong>{{displayDmgFormula}}</strong>
                </span>
                <span class="meta-badge skill-badge">
                    <i class="fas fa-fist-raised"></i>
                    {{localize "WITCHER.Dialog.attackUse"}}: <strong>{{localize attackSkill.alias}}</strong>
                </span>
            </div>
        </div>
        {{#if meleeBonus}}
            <div class="melee-bonus-badge">
                <label>{{localize "WITCHER.Dialog.attackMeleeBonus"}}</label>
                <span>+{{meleeBonus}}</span>
            </div>
        {{/if}}
        <div class="banner-border-line-bottom"></div>
    </div>

    {{!-- 3-Column Side-By-Side Layout --}}
    <div class="attack-sheet-grid-3col">
        
        {{!-- COLUMN 1: Azione Colpo (Strike Action) --}}
        <section class="config-section action-config">
            <h4><i class="fas fa-crosshairs"></i> {{localize "WITCHER.Dialog.attackAction"}}</h4>
            <div class="form-group">
                <label>{{localize "WITCHER.Dialog.attackStrike"}}</label>
                <div class="select-wrapper">
                    <select name="strike">
                        {{selectOptions config.weapon.attacks localize=true}}
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>{{localize "WITCHER.Dialog.attackLocation"}}</label>
                <div class="select-wrapper">
                    <select name="location">
                        <option value="randomHuman"> {{localize "WITCHER.Dialog.attackRandomHuman"}} </option>
                        <option value="randomMonster"> {{localize "WITCHER.Dialog.attackRandomMonster"}} </option>
                        <option value="head"> {{localize "WITCHER.Dialog.attackHead"}} </option>
                        <option value="torso"> {{localize "WITCHER.Dialog.attackTorso"}} </option>
                        <option value="leftArm"> {{localize "WITCHER.Dialog.attackLArm"}} </option>
                        <option value="rightArm"> {{localize "WITCHER.Dialog.attackRArm"}} </option>
                        <option value="leftLeg"> {{localize "WITCHER.Dialog.attackLLeg"}} </option>
                        <option value="rightLeg"> {{localize "WITCHER.Dialog.attackRLeg"}} </option>
                        <option value="tailWing"> {{localize "WITCHER.Dialog.attackTail"}} </option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>{{localize "WITCHER.Dialog.damageType"}}</label>
                <div class="select-wrapper">
                    <select name="damageType">
                        {{#if item.system.type.slashing}}
                            <option value="slashing">{{localize "WITCHER.DamageType.slashing"}}</option>
                        {{/if}}
                        {{#if item.system.type.piercing}}
                            <option value="piercing">{{localize "WITCHER.DamageType.piercing"}}</option>
                        {{/if}}
                        {{#if item.system.type.bludgeoning}}
                            <option value="bludgeoning">{{localize "WITCHER.DamageType.bludgeoning"}}</option>
                        {{/if}}
                        {{#if item.system.type.elemental}}
                            <option value="elemental">{{localize "WITCHER.DamageType.elemental"}}</option>
                        {{/if}}
                        {{#if (and (ne item.system.type.slashing true) (ne item.system.type.piercing true) (ne item.system.type.bludgeoning true) (ne item.system.type.elemental true))}}
                            <option value="unavailable">{{localize "WITCHER.Context.unavailable"}}</option>
                        {{/if}}
                    </select>
                </div>
            </div>
            
            {{!-- Extra Attack checkbox inside Column 1 --}}
            <div class="form-group toggle-wrapper-row">
                <label class="toggle-row-label">
                    <span class="toggle-title">
                        <i class="fas fa-bolt"></i> {{localize "WITCHER.Dialog.attackExtra"}}
                    </span>
                    <input type="checkbox" name="isExtraAttack" class="styled-checkbox">
                </label>
            </div>
        </section>

        {{!-- COLUMN 2: Modificatori Attacco (Modifiers) --}}
        <section class="config-section condition-config">
            <h4><i class="fas fa-sliders-h"></i> {{localize "WITCHER.Dialog.attackModifiers"}}</h4>
            
            {{#if item.system.range}}
            <div class="form-group range-selector-group">
                <label>{{localize "WITCHER.Dialog.attackRange"}} ({{item.system.range}})</label>
                <div class="select-wrapper">
                    <select name="range">
                        <option value="none"> {{localize "WITCHER.Dialog.rangeNone"}} </option>
                        <option value="pointBlank"> {{localize "WITCHER.Dialog.rangePointBlank"}} </option>
                        <option value="close"> {{localize "WITCHER.Dialog.rangeClose"}}</option>
                        <option value="medium"> {{localize "WITCHER.Dialog.rangeMedium"}} </option>
                        <option value="long"> {{localize "WITCHER.Dialog.rangeLong"}} </option>
                        <option value="extreme"> {{localize "WITCHER.Dialog.rangeExtreme"}} </option>
                    </select>
                </div>
            </div>
            {{/if}}

            <div class="advanced-mods-container">
                <h5 class="sub-section-title"><i class="fas fa-cog"></i> {{localize "WITCHER.Dialog.advanced"}}</h5>
                <div class="scrollable-mods-list">
                    {{!-- Bonuses --}}
                    <label class="mod-row bonus-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackOutsideLOS"}}
                            <span class="mod-val bonus">+3</span>
                        </span>
                        <input type="checkbox" name="outsideLOS">
                    </label>
                    <label class="mod-row bonus-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsPinned"}}
                            <span class="mod-val bonus">+4</span>
                        </span>
                        <input type="checkbox" name="isPinned">
                    </label>
                    <label class="mod-row bonus-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsAmbush"}}
                            <span class="mod-val bonus">+5</span>
                        </span>
                        <input type="checkbox" name="isAmbush">
                    </label>
                    <label class="mod-row bonus-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsSilhouetted"}}
                            <span class="mod-val bonus">+2</span>
                        </span>
                        <input type="checkbox" name="isSilhouetted">
                    </label>
                    
                    {{!-- Numeric Aim --}}
                    <div class="mod-row numeric-row">
                        <label>
                            <span class="mod-label-text">
                                {{localize "WITCHER.Dialog.attackIsAiming"}}
                                <span class="mod-val bonus">+1</span>
                            </span>
                        </label>
                        <input type="number" class="small-input" name="customAim" value="0" min="0" max="3">
                    </div>

                    {{!-- Penalties --}}
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackTargetOutsideLOS"}}
                            <span class="mod-val penalty">-3</span>
                        </span>
                        <input type="checkbox" name="targetOutsideLOS">
                    </label>
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsActivelyDodging"}}
                            <span class="mod-val penalty">-2</span>
                        </span>
                        <input type="checkbox" name="isActivelyDodging">
                    </label>
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsMoving"}}
                            <span class="mod-val penalty">-3</span>
                        </span>
                        <input type="checkbox" name="isMoving">
                    </label>
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsProne"}}
                            <span class="mod-val penalty">-2</span>
                        </span>
                        <input type="checkbox" name="isProne">
                    </label>
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsBlinded"}}
                            <span class="mod-val penalty">-3</span>
                        </span>
                        <input type="checkbox" name="isBlinded">
                    </label>
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsRicochet"}}
                            <span class="mod-val penalty">-5</span>
                        </span>
                        <input type="checkbox" name="isRicochet">
                    </label>
                    <label class="mod-row penalty-row">
                        <span class="mod-label-text">
                            {{localize "WITCHER.Dialog.attackIsFastDraw"}}
                            <span class="mod-val penalty">-3</span>
                        </span>
                        <input type="checkbox" name="isFastDraw">
                    </label>
                </div>
            </div>
        </section>

        {{!-- COLUMN 3: Risorse, Custom e Munizioni (Resources & Custom) --}}
        <section class="config-section resources-config">
            <h4><i class="fas fa-hand-holding-usd"></i> {{localize "WITCHER.Settings.Custom"}}</h4>
            
            <div class="custom-fields-stack">
                <div class="form-group luck-group">
                    <label>
                        <i class="fas fa-dice"></i>
                        {{localize "WITCHER.Actor.Stat.Luck"}} ({{system.stats.luck.value}})
                    </label>
                    <input type="number" name="luckToSpend" value="0" min="0" max="{{system.stats.luck.value}}">
                </div>
                
                <div class="form-group custom-att-group">
                    <label>
                        <i class="fas fa-plus-circle"></i>
                        {{localize "WITCHER.Dialog.attackCustomMod"}}
                    </label>
                    <input type="number" name="customAtt" value="0">
                </div>
                
                <div class="form-group custom-dmg-group">
                    <label>
                        <i class="fas fa-hand-sparkles"></i>
                        {{localize "WITCHER.Dialog.attackCustomDmg"}}
                    </label>
                    <input type="text" name="customDmg" value="0">
                </div>
            </div>

            {{!-- Ammo / Throwable Selection inside Column 3 for a perfectly integrated look! --}}
            {{#if (or item.system.usingAmmo item.system.isThrowable)}}
            <div class="ammo-throwable-section">
                <h5 class="sub-section-title"><i class="fas fa-box-open"></i> Munizioni / Oggetti</h5>
                
                {{#if item.system.usingAmmo}}
                    <div class="form-group ammo-group">
                        {{#if (eq noAmmo 1)}}
                            <div class="ammo-status no-ammo">
                                <i class="fas fa-exclamation-triangle"></i>
                                <label class="error-display">{{localize "WITCHER.Dialog.NoAmmunition"}}</label>
                            </div>
                        {{else}}
                            <label class="footer-sub-label"><i class="fas fa-dot-circle"></i> {{localize "WITCHER.Dialog.Ammunition"}}</label>
                            <div class="select-wrapper">
                                <select name="ammunition">
                                    {{{ammunitionOption}}}
                                </select>
                            </div>
                        {{/if}}
                    </div>
                {{/if}}

                {{#if item.system.isThrowable}}
                    <div class="form-group throwable-group">
                        {{#if noThrowable }}
                            <div class="ammo-status no-ammo">
                                <i class="fas fa-exclamation-triangle"></i>
                                <label class="error-display">{{localize "WITCHER.Dialog.NoThrowable"}}</label>
                            </div>
                        {{else}}
                            <label class="footer-sub-label"><b><i class="fas fa-bullseye"></i> {{localize "WITCHER.Dialog.Throwable"}}</b></label>
                            <span class="throwable-count">
                                <i class="fas fa-check-circle"></i> {{item.system.quantity}} disponibili
                            </span>
                        {{/if}}
                    </div>
                {{/if}}
            </div>
            {{/if}}
        </section>
    </div>
</div>