<div class="weapon_roll_sheet">
    {{!-- Premium Header Banner --}}
    <div class="item-header-info premium-banner">
        <div class="banner-border-line-top"></div>
        <img class="item-img" src="{{item.img}}" title="{{item.name}}" />
        <div class="item-info-text">
            <h3 class="item-name">{{item.name}}</h3>
            <div class="item-meta-badges">
                {{#if causeDamage}}
                <span class="meta-badge dmg-badge">
                    <i class="fas fa-dice-d20"></i>
                    {{localize "WITCHER.Dialog.attackDamage"}}: <strong>{{item.system.damage}}</strong>
                </span>
                {{/if}}
                <span class="meta-badge skill-badge">
                    <i class="fas fa-magic"></i>
                    {{localize "WITCHER.Spell.MagicCost"}}: <strong>{{#if staminaIsVar}}{{localize "WITCHER.Spell.Short.Variable"}}{{else}}{{item.system.stamina}} {{localize "WITCHER.Actor.DerStat.Sta"}}{{/if}}</strong>
                </span>
            </div>
        </div>
        <div class="banner-border-line-bottom"></div>
    </div>

    {{!-- Layout --}}
    <div class="attack-sheet-grid-3col">
        
        {{!-- COLUMN 1: Spell Parameters (Action) --}}
        <section class="config-section action-config">
            <h4><i class="fas fa-crosshairs"></i> {{localize "WITCHER.Dialog.attackAction"}}</h4>
            
            {{#if causeDamage}}
            <div class="form-group">
                <label>{{localize "WITCHER.Dialog.attackLocation"}}</label>
                <div class="select-wrapper">
                    <select name="location">
                        <option value="randomHuman"> {{localize "WITCHER.Dialog.attackRandomHuman"}} </option>
                        <option value="randomMonster"> {{localize "WITCHER.Dialog.attackRandomMonster"}} </option>
                        <option value="head"> {{localize "WITCHER.Dialog.attackHead"}} </option>
                        <option value="torso"> {{localize "WITCHER.Dialog.attackTorso"}} </option>
                        <option value="leftArm"> {{localize "WITCHER.Dialog.attackLArm"}} </option>
                        <option value="rightArm"> {{localize "WITCHER.Dialog.attackRArm"}} </option>
                        <option value="leftLeg"> {{localize "WITCHER.Dialog.attackLLeg"}} </option>
                        <option value="rightLeg"> {{localize "WITCHER.Dialog.attackRLeg"}} </option>
                        <option value="tailWing"> {{localize "WITCHER.Dialog.attackTail"}} </option>
                    </select>
                </div>
            </div>
            {{/if}}
            
            <div class="form-group toggle-wrapper-row">
                <label class="toggle-row-label">
                    <span class="toggle-title">
                        <i class="fas fa-bolt"></i> {{localize "WITCHER.Dialog.attackExtra"}}
                    </span>
                    <input type="checkbox" name="isExtraAttack" class="styled-checkbox">
                </label>
            </div>
            
        </section>

        {{!-- COLUMN 2: Spell Mechanics (Focus & Stamina) --}}
        <section class="config-section condition-config">
            <h4><i class="fas fa-hat-wizard"></i> {{localize "WITCHER.Item.Type.Spell"}}</h4>
            
            {{#if staminaIsVar}}
            <div class="form-group">
                <label><i class="fas fa-fire"></i> {{localize "WITCHER.Spell.staminaDialog"}}</label>
                <input type="number" class="small-input" name="staCost" value="1" min="1" max="7">
            </div>
            {{/if}}

            {{#if useFocus}}
            <div class="form-group">
                <label>{{localize "WITCHER.Spell.ChooseFocus"}}</label>
                <div class="select-wrapper">
                    <select name="focus">
                        <option value="" data-value="0" data-superior="false">{{localize "WITCHER.None"}}</option>
                        {{#each focusOptions as |focusOption|}}
                            <option value="{{@key}}" data-value="{{focusOption.value}}" data-superior="{{focusOption.superior}}">{{focusOption.label}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            {{#if hasExpandedMagicSkill}}
            <div class="form-group toggle-wrapper-row">
                <label class="toggle-row-label">
                    <span class="toggle-title">
                        <i class="fas fa-hat-wizard"></i> {{localize "WITCHER.Spell.UseExpandedMagic"}}
                    </span>
                    <input type="checkbox" name="useExpandedFocus" class="styled-checkbox">
                </label>
            </div>
            <div class="form-group">
                <label>{{localize "WITCHER.Spell.ChooseExpandedFocus"}}</label>
                <div class="select-wrapper">
                    <select name="secondFocus">
                        <option value="" data-value="0" data-superior="false">{{localize "WITCHER.None"}}</option>
                        {{#each focusOptions as |focusOption|}}
                            <option value="{{@key}}" data-value="{{focusOption.value}}" data-superior="{{focusOption.superior}}">{{focusOption.label}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            {{/if}}
            {{/if}}
        </section>

        {{!-- COLUMN 3: Modifiers --}}
        <section class="config-section resources-config">
            <h4><i class="fas fa-sliders-h"></i> {{localize "WITCHER.Dialog.attackModifiers"}}</h4>
            
            <div class="custom-fields-stack">
                <div class="form-group custom-att-group">
                    <label>
                        <i class="fas fa-plus-circle"></i>
                        {{localize "WITCHER.Dialog.attackCustomMod"}}
                    </label>
                    <input type="number" name="customMod" value="0">
                </div>
            </div>
        </section>
        
    </div>
</div>
