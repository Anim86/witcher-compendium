<div class="wizard-step step-stats">
    <div class="step-header">
        <h2>{{localize "WITCHER.Wizard.Step.Stats.Title"}}</h2>
        <p>{{localize "WITCHER.Wizard.Step.Stats.Description"}}</p>
    </div>

    <div class="stats-outer-container">
        <div class="points-display">
            {{localize "WITCHER.Wizard.Stats.PointsRemaining"}}: 
            <span class="points-value {{#if (lt pointsRemaining 0)}}negative{{/if}}">{{pointsRemaining}}</span>
        </div>

        <div class="stats-grid">
            {{#each stats}}
            <div class="stat-row" data-stat="{{@key}}">
                <label>{{localize label}}</label>
                
                <div class="stat-controls">
                    <button type="button" data-action="adjustStat" data-stat="{{@key}}" data-delta="-1">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                    <input type="number" 
                           data-action="adjustStat" 
                           data-stat="{{@key}}" 
                           name="stats.{{@key}}" 
                           value="{{value}}" 
                           min="1" 
                           max="10">
                    <button type="button" data-action="adjustStat" data-stat="{{@key}}" data-delta="1">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>

                <div class="stat-description">
                    {{localize (concat "WITCHER.Actor.Stat.Desc." @key)}}
                </div>
            </div>
            {{/each}}
        </div>

        <div class="derived-stats-preview">
            <h3>{{localize "WITCHER.Wizard.Stats.DerivedPreview"}}</h3>
            <div class="derived-grid">
                <div class="derived-item">
                    <label>{{localize "WITCHER.Actor.DerStat.HP"}}:</label>
                    <span>{{derived.hp}}</span>
                </div>
                <div class="derived-item">
                    <label>{{localize "WITCHER.Actor.DerStat.Sta"}}:</label>
                    <span>{{derived.sta}}</span>
                </div>
                <div class="derived-item">
                    <label>{{localize "WITCHER.Actor.DerStat.Rec"}}:</label>
                    <span>{{derived.rec}}</span>
                </div>
                <div class="derived-item">
                    <label>{{localize "WITCHER.Actor.DerStat.Stun"}}:</label>
                    <span>{{derived.stun}}</span>
                </div>
                <div class="derived-item">
                    <label>{{localize "WITCHER.Actor.DerStat.Run"}}:</label>
                    <span>{{derived.run}}m</span>
                </div>
            </div>
        </div>
    </div>
</div>
